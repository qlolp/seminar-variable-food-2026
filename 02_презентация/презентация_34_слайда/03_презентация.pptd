version: v2
title: Не просто накормить — презентация семинара
size: [960, 540]
theme:
  colors:
    primary: "#1F6E5C"
    accent: "#E8A33D"
    text: "#1C1B18"
    muted: "#7A7468"
    bg: "#FBF8F3"
    soft: "#EFE9DD"
    line: "#DED6C6"
    risk: "#C14B3A"
    dark: "#14251F"
    darkcard: "#1E352D"
    cream: "#F5EFE3"
    sand: "#E9E2D2"
  textStyles:
    kicker:
      fontSize: 11
      color: "$primary"
      fontFamily: Noto Sans
      letterSpacing: 2
      bold: true
    h1:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
    body:
      fontSize: 14.5
      color: "$text"
      fontFamily: Noto Sans
      lineHeight: 1.45
    small:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      lineHeight: 1.3
    big:
      fontSize: 46
      bold: true
      color: "$primary"
      fontFamily: PT Serif
    q:
      fontSize: 30
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      lineHeight: 1.25
pages:
