pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "СИСТЕМА · КУХНЯ НЕ СВОЯ"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Кухня не своя — вариативность живёт в восьми строках контракта"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: sub
    elementType: text
    bounds: [60, 124, 840, 44]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Без своей плиты директор не «добавляет вторую кастрюлю» — он меняет спецификацию. Если контракт уже идёт — пилот начинается с допсоглашения и приёмки, не с линии."
  - elementId: r1
    elementType: shape
    bounds: [60, 186, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r1t
    elementType: text
    bounds: [78, 196, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· минимум два варианта в точке приёма пищи — в спецификации"
  - elementId: r2
    elementType: shape
    bounds: [60, 244, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r2t
    elementType: text
    bounds: [78, 254, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· объёмы по журналу заказа, а не «средний расход»"
  - elementId: r3
    elementType: shape
    bounds: [60, 302, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r3t
    elementType: text
    bounds: [78, 312, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· альтернатива при отказе — в регламенте замен"
  - elementId: r4
    elementType: shape
    bounds: [60, 360, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r4t
    elementType: text
    bounds: [78, 370, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· суточные пробы с каждого блюда — в приёмке"
  - elementId: r5
    elementType: shape
    bounds: [496, 186, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r5t
    elementType: text
    bounds: [514, 196, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· маркировка вариантов и текстур — клинический элемент"
  - elementId: r6
    elementType: shape
    bounds: [496, 244, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r6t
    elementType: text
    bounds: [514, 254, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· журнал срывов и замен — общий, а не «их»"
  - elementId: r7
    elementType: shape
    bounds: [496, 302, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r7t
    elementType: text
    bounds: [514, 312, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· температура на линии и последнем столе — в приёмке"
  - elementId: r8
    elementType: shape
    bounds: [496, 360, 404, 48]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: r8t
    elementType: text
    bounds: [514, 370, 372, 30]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "· ответственность за срыв — санкции по контракту"
  - elementId: note
    elementType: text
    bounds: [60, 432, 840, 58]
    content:
      fontSize: 13.5
      color: "$muted"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: "<strong>Честно:</strong> публичных кейсов вариативности именно на аутсорсинге в открытых источниках нет — это пробел доклада, а не доказательство невозможности. Осенний календарь закупки (раздел 42.7) важнее любого слайда."
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 42 — аутсорсинг: восемь строк контракта"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 591, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "26"
