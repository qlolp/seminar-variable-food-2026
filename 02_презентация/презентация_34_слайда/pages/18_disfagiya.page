pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "КЛИНИКА · ДИСФАГИЯ"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Дисфагия — скрытая эпидемия стационарного стола"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: big
    elementType: text
    bounds: [60, 136, 360, 110]
    content:
      fontSize: 56
      bold: true
      color: "$risk"
      fontFamily: PT Serif
      text: "каждый пятый"
  - elementId: bigl
    elementType: text
    bounds: [60, 246, 360, 80]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "минимум — таковы исследования распространённости расстройства глотания. В типовом ПНИ нет ни логопеда, ни скрининга: дисфагия невидима до первой тяжёлой пневмонии."
  - elementId: signs_h
    elementType: text
    bounds: [440, 136, 460, 26]
    content:
      fontSize: 13
      bold: true
      color: "$text"
      fontFamily: Noto Sans
      text: "Шесть признаков, видимых без инструментов:"
  - elementId: sg1
    elementType: shape
    bounds: [440, 170, 225, 44]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sg1t
    elementType: text
    bounds: [452, 178, 202, 30]
    content:
      fontSize: 12
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "кашель при еде"
  - elementId: sg2
    elementType: shape
    bounds: [675, 170, 225, 44]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sg2t
    elementType: text
    bounds: [687, 178, 202, 30]
    content:
      fontSize: 12
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "«мокрый» голос после глотка"
  - elementId: sg3
    elementType: shape
    bounds: [440, 224, 225, 44]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sg3t
    elementType: text
    bounds: [452, 232, 202, 30]
    content:
      fontSize: 12
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "долгое пережёвывание без глотания"
  - elementId: sg4
    elementType: shape
    bounds: [675, 224, 225, 44]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sg4t
    elementType: text
    bounds: [687, 232, 202, 30]
    content:
      fontSize: 12
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "скопление пищи за щекой"
  - elementId: sg5
    elementType: shape
    bounds: [440, 278, 225, 44]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sg5t
    elementType: text
    bounds: [452, 286, 202, 30]
    content:
      fontSize: 12
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "подтекание изо рта"
  - elementId: sg6
    elementType: shape
    bounds: [675, 278, 225, 44]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sg6t
    elementType: text
    bounds: [687, 286, 202, 30]
    content:
      fontSize: 12
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "повторные пневмонии в анамнезе"
  - elementId: note
    elementType: text
    bounds: [440, 336, 460, 30]
    content:
      fontSize: 12
      color: "$muted"
      fontFamily: Noto Sans
      text: "Любой признак → запись → врач. Это выучивается сменой за один инструктаж."
  - elementId: iddsi
    elementType: shape
    bounds: [60, 352, 840, 84]
    shapeName: rect
    fill: {type: solid, color: "#E4EFE9", radius: 8}
  - elementId: iddsit
    elementType: text
    bounds: [84, 364, 800, 62]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong>IDDSI — международная шкала текстур: 8 уровней с тестами вилкой и наклоном.</strong> Внедрение в пяти учреждениях подняло соответствие текстур назначенным с 44 % до 90 %, жидкостей — с 31 % до 100 %.</p>
        <p>Программа начинается не с блендера, а с обучения смены. Назначение текстуры — решение врача, с пересмотром.</p>
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 10 — дисфагия и риск аспирации; источники M-dysph_prev, M-iddsi_wu, M-iddsi2017"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 409, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "18"
