pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 700, 16]
    content:
      style: "$kicker"
      text: "НАУКА 2024–2026"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Четыре подтверждения, одно следствие"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: c1
    elementType: shape
    bounds: [60, 128, 410, 112]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t1
    elementType: text
    bounds: [80, 144, 370, 80]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>Япония.</strong> База LIFE уже даёт исследования, не только отчёты.</p>"
  - elementId: c2
    elementType: shape
    bounds: [490, 128, 410, 112]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t2
    elementType: text
    bounds: [510, 144, 370, 80]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>IDDSI.</strong> Без обучения персонал применяет шкалу с ошибками.</p>"
  - elementId: c3
    elementType: shape
    bounds: [60, 256, 410, 112]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t3
    elementType: text
    bounds: [80, 272, 370, 80]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>Трапеза.</strong> Организация стола влияет не меньше меню.</p>"
  - elementId: c4
    elementType: shape
    bounds: [490, 256, 410, 112]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t4
    elementType: text
    bounds: [510, 272, 370, 80]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>Вес.</strong> Мониторинг и белок — плановая работа, не опция.</p>"
  - elementId: bottom
    elementType: text
    bounds: [60, 392, 840, 56]
    content:
      fontSize: 17
      bold: true
      color: "$primary"
      lineHeight: 1.35
      text: "Еда — это выбор и процедура, а не только калорийность нормы."
  - elementId: src
    elementType: text
    bounds: [60, 500, 780, 28]
    content:
      style: "$small"
      text: "Hori 2025; Griffin 2024; Maggie Beer / Cartwright 2026; Harstäde 2025; Seiter 2025; Yoshimura 2025."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "45"
