pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "СИСТЕМА · ПРОВЕРКА"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Проверяющий спросит — отвечайте документом"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: q1
    elementType: shape
    bounds: [60, 134, 266, 200]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: q1h
    elementType: text
    bounds: [76, 148, 234, 40]
    content:
      fontSize: 13.5
      bold: true
      color: "$text"
      fontFamily: Noto Sans
      text: "«Почему два варианта?»"
  - elementId: q1t
    elementType: text
    bounds: [76, 196, 234, 120]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "<strong>Ответ:</strong> положение о вариативном питании + таблицы замен продуктов. Варианты — эквиваленты внутри нормы, а не «что попало»."
  - elementId: q2
    elementType: shape
    bounds: [347, 134, 266, 200]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: q2h
    elementType: text
    bounds: [363, 148, 234, 40]
    content:
      fontSize: 13.5
      bold: true
      color: "$text"
      fontFamily: Noto Sans
      text: "«Где пробы второго блюда?»"
  - elementId: q2t
    elementType: text
    bounds: [363, 196, 234, 120]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "<strong>Ответ:</strong> суточные пробы с каждого блюда — обе гастроёмкости, обе строки журнала. Температура — на обеих ёмкостях, на линии и на последнем столе."
  - elementId: q3
    elementType: shape
    bounds: [634, 134, 266, 200]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: q3h
    elementType: text
    bounds: [650, 148, 234, 40]
    content:
      fontSize: 13.5
      bold: true
      color: "$text"
      fontFamily: Noto Sans
      text: "«Кто назначил диету?»"
  - elementId: q3t
    elementType: text
    bounds: [650, 196, 234, 120]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "<strong>Ответ:</strong> врач, поимённо, со сроком пересмотра — список в пищевых картах. Ограничений «по представлению сиделки» нет и не будет."
  - elementId: key
    elementType: shape
    bounds: [60, 356, 840, 108]
    shapeName: rect
    fill: {type: solid, color: "#E4EFE9", radius: 8}
  - elementId: keyt
    elementType: text
    bounds: [84, 370, 800, 82]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong>Страх проверки лечится комплектом, а не отказом от практики.</strong> Три типовых вопроса и три документальных ответа разобраны в разделе 32.</p>
        <p>И главное правило: <strong>не говорить проверяющему того, чего нет в документах.</strong> Если журнал ведётся с сегодняшнего дня — так и сказано; «привести в порядок» задним числом — это уже имитация контроля.</p>
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, разделы 32 и 33 — сценарий диалога и карта ответственности"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 568, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "25"
