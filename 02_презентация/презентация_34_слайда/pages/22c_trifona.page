pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 820, 16]
    content:
      style: "$kicker"
      text: "ТРИ НЕЗАМЕЧЕННЫЕ ЗАЩИТЫ · РАЗДЕЛЫ 10.7–10.11"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Рот · стакан · стул"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: card1
    elementType: shape
    bounds: [60, 128, 270, 280]
    shapeName: rect
    cornerRadius: 16
    fill: {type: solid, color: "$soft"}
  - elementId: h1
    elementType: text
    bounds: [80, 148, 230, 28]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      letterSpacing: 1
      text: "РОТ"
  - elementId: n1
    elementType: text
    bounds: [80, 184, 230, 56]
    content:
      style: "$big"
      text: "11% vs 19%"
  - elementId: t1
    elementType: text
    bounds: [80, 250, 230, 136]
    content:
      fontSize: 14
      lineHeight: 1.4
      text: "<p>% пневмоний в РКИ: уход за полостью рта vs без него.</p><p style=\"margin-top:8px\">Не «две минуты на всех» — группа зависимости.</p>"
  - elementId: card2
    elementType: shape
    bounds: [345, 128, 270, 280]
    shapeName: rect
    cornerRadius: 16
    fill: {type: solid, color: "$soft"}
  - elementId: h2
    elementType: text
    bounds: [365, 148, 230, 28]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      letterSpacing: 1
      text: "СТАКАН"
  - elementId: n2
    elementType: text
    bounds: [365, 184, 230, 56]
    content:
      fontSize: 32
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "питьё ↓"
  - elementId: t2
    elementType: text
    bounds: [365, 250, 230, 136]
    content:
      fontSize: 14
      lineHeight: 1.4
      text: "<p>Загуститель снижает потребление жидкости. Данных, что меньше осложнений, нет.</p><p style=\"margin-top:8px\">Считайте «выпито за сутки».</p>"
  - elementId: card3
    elementType: shape
    bounds: [630, 128, 270, 280]
    shapeName: rect
    cornerRadius: 16
    fill: {type: solid, color: "$soft"}
  - elementId: h3
    elementType: text
    bounds: [650, 148, 230, 28]
    content:
      fontSize: 13
      bold: true
      color: "$primary"
      letterSpacing: 1
      text: "СТУЛ"
  - elementId: n3
    elementType: text
    bounds: [650, 184, 230, 56]
    content:
      fontSize: 36
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "3 суток"
  - elementId: t3
    elementType: text
    bounds: [650, 250, 230, 136]
    content:
      fontSize: 14
      lineHeight: 1.4
      text: "<p>На клозапине запор частый и может быть фатален.</p><p style=\"margin-top:8px\">Трое суток без стула у группы риска — врач сегодня.</p>"
  - elementId: src
    elementType: text
    bounds: [60, 430, 840, 64]
    content:
      style: "$small"
      text: "Yoneyama 2002; Müller 2015; Every-Palmer 2017. Приложение 37."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "32"
