pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 700, 16]
    content:
      style: "$kicker"
      text: 'ТЕКСТУРЫ · ЗАМЕР ДО И ПОСЛЕ'
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Единая шкала IDDSI: соответствие выросло вдвое"
  - elementId: line
    elementType: shape
    bounds: [60, 108, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: chart
    elementType: chart
    bounds: [60, 126, 840, 330]
    fontFamily: "Noto Sans"
    data:
      cols: ["Параметр", "До", "После"]
      rows:
      - ["Соответствие текстур назначению", 44, 90]
      - ["Соответствие жидкостей", 31, 100]
    series:
      - type: bar
        encode: {x: "Параметр", y: "До"}
        name: "До единой шкалы, %"
        fill: "#A8A294"
        dataLabels: {show: true, color: "#6E6A5E"}
      - type: bar
        encode: {x: "Параметр", y: "После"}
        name: "После обучения, %"
        fill: "$accent"
        dataLabels: {show: true, color: "#FFFFFF"}
    legend: {position: bottom, color: "#6E6A5E"}
    yAxis: {min: 0, max: 100, title: "соответствие, %", label: {color: "#8A8578"}, gridLine: {color: "#E5E2D8"}}
    xAxis: {label: {color: "#4A463C"}, axisLine: {color: "#D6D1C4"}, gridLine: false}
    categoryGap: 0.45

  - elementId: note
    elementType: text
    bounds: [60, 462, 840, 40]
    content:
      fontSize: 12.5
      lineHeight: 1.45
      color: "$text"
      fontFamily: "Noto Sans"
      text: "Изменение достигнуто именно обучением, а не оборудованием: та же кухня, те же продукты — другая точность."

  - elementId: src
    elementType: text
    bounds: [60, 508, 760, 24]
    content:
      style: "$small"
      text: "Раздел 19 доклада; шкала IDDSI — приложение"
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "#A8A294"
      align: [right, top]
      text: "14"
