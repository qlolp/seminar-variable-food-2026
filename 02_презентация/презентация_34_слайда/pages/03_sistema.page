pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "МАСШТАБ · КОГО КАСАЕТСЯ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Более 174 000 человек едят трижды в день по чужому решению"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: n1
    elementType: text
    bounds: [60, 140, 400, 96]
    content:
      fontSize: 64
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "174 000+"
  - elementId: n1l
    elementType: text
    bounds: [60, 240, 400, 44]
    content:
      fontSize: 14.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "человек живут в стационарных организациях социального обслуживания"
  - elementId: n2
    elementType: text
    bounds: [500, 140, 400, 96]
    content:
      fontSize: 64
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "139 500"
  - elementId: n2l
    elementType: text
    bounds: [500, 240, 400, 44]
    content:
      fontSize: 14.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "из них — жители психоневрологических интернатов"
  - elementId: chips
    elementType: text
    bounds: [60, 320, 840, 70]
    content:
      fontSize: 13
      color: "$muted"
      lineHeight: 1.6
      fontFamily: Noto Sans
      text: |
        <p><strong style="color:$text">51 регион</strong> — участники семинара · <strong style="color:$text">41 регион</strong> переименовал ПНИ в дома социального обслуживания · <strong style="color:$text">7 000</strong> человек уже перешли в сопровождаемое проживание — и им понадобился навык, который тренируется за столом</p>
  - elementId: takeaway
    elementType: text
    bounds: [60, 416, 840, 64]
    content:
      fontSize: 15
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: |
        <p><strong>Еда — единственная услуга, которую система оказывает каждому жителю три-четыре раза в день, каждый день.</strong></p>
        <p>Ни одна другая зона не даёт столько ежедневных контактов с человеком — и столько возможностей для ошибки.</p>
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 23 — ориентиры по вторичной аналитике, не официальная отчётность Минтруда"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 68, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "3"
