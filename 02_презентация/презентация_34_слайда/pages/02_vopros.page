pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ВОПРОС ЗАЛУ № 1"
  - elementId: q
    elementType: text
    bounds: [60, 110, 840, 160]
    content:
      style: "$q"
      text: "Кто в вашем учреждении в действительности выбирает, что сегодня будет есть житель?"
  - elementId: opts
    elementType: text
    bounds: [60, 290, 840, 110]
    content:
      fontSize: 17
      color: "$text"
      lineHeight: 1.9
      text: |
        <p>он сам&nbsp;&nbsp;·&nbsp;&nbsp;санитар&nbsp;&nbsp;·&nbsp;&nbsp;врач</p>
        <p>кухня&nbsp;&nbsp;·&nbsp;&nbsp;контрактный управляющий&nbsp;&nbsp;·&nbsp;&nbsp;региональная норма</p>
  - elementId: rule
    elementType: shape
    bounds: [60, 420, 200, 2]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: hint
    elementType: text
    bounds: [60, 438, 840, 44]
    content:
      fontSize: 14
      color: "$muted"
      lineHeight: 1.4
      text: "Поднимите руку на своём варианте. Отвечаем честно — это не проверка, а исходная точка, от которой считается путь."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "2"
