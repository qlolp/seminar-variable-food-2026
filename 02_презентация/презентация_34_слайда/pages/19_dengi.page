pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ДЕНЬГИ · ЧЕСТНАЯ ТАБЛИЦА"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Что почём на каждой ступени: деньги, труд, документы"
  - elementId: table
    elementType: table
    bounds: [60, 120, 840, 280]
    columnWidths: [0.22, 0.26, 0.26, 0.26]
    rowHeights: [0.16, 0.21, 0.21, 0.21, 0.21]
    style:
      cellStyle: {fontSize: 13, lineHeight: 1.3, align: [left, middle], border: [null, null, {style: solid, width: 1, color: "$line"}, null]}
      firstRowStyle: {bold: true, color: "$primary", fontSize: 13.5}
    rows:
      - - text: "Ступень"
        - text: "Новые деньги"
        - text: "Новый труд"
        - text: "Ключевые документы"
      - - text: "0. Учёт отказов"
        - text: "нет"
        - text: "ведомость остатков, журнал отказов"
        - text: "таблица замен, журнал отказов"
      - - text: "1. Два варианта позиции"
        - text: "практически нет (парные эквиваленты)"
        - text: "одна гастроёмкость, одна страница журнала в день"
        - text: "+ журнал заказа, приказ о пилоте"
      - - text: "2. Все позиции ежедневно"
        - text: "посуда и логистика (термоконтейнеры)"
        - text: "пересчёт объёмов по статистике"
        - text: "+ журнал срывов, квартальная панель"
      - - text: "3–5. Линия, семейная подача, своя кухня"
        - text: "зонирование, мебель, оборудование — по смете"
        - text: "смена роли персонала"
        - text: "согласование с учредителем и врачом"
  - elementId: bottom
    elementType: text
    bounds: [60, 420, 840, 56]
    content:
      fontSize: 14.5
      bold: true
      lineHeight: 1.45
      text: "Вариативность не «почти бесплатна»: трудозатраты реальны и названы. Бюджетных затрат на ступенях 0–1 нет — это подтверждено действующими практиками."
  - elementId: src
    elementType: text
    bounds: [60, 505, 760, 24]
    content:
      style: "$small"
      text: "Источник: разделы 29–30 доклада; листы «Решения без средств» и «Решения с финансированием» — семинарский пакет, элементы 15–16"
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "24"
