    elementType: text
    bounds: [670, 152, 210, 110]
    content:
      fontSize: 17
      lineHeight: 1.35
      text: "<p><strong>Шаг 3</strong></p><p>Журнал — «для проверки». Выбор снова делает кухня</p>"
  - elementId: anti
    elementType: shape
    bounds: [60, 304, 840, 108]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$primary"}
