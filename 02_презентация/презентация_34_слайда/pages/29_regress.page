pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 700, 16]
    content:
      style: "$kicker"
      text: "РЕГРЕСС · РАЗДЕЛЫ 8.5 И 31"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Через год всё вернётся — если держится на одном человеке"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: c1
    elementType: shape
    bounds: [60, 128, 250, 150]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t1
    elementType: text
    bounds: [80, 152, 210, 110]
    content:
      fontSize: 17
      lineHeight: 1.35
      text: "<p><strong>Шаг 1</strong></p><p>Уходит инициатор</p>"
  - elementId: ar1
    elementType: line
    bounds: [318, 188, 36, 24]
    viewBox: [36, 24]
    points: "0,12 30,12"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: c2
    elementType: shape
    bounds: [355, 128, 250, 150]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t2
    elementType: text
    bounds: [375, 152, 210, 110]
    content:
      fontSize: 17
      lineHeight: 1.35
      text: "<p><strong>Шаг 2</strong></p><p>Меню «временно» упрощают</p>"
  - elementId: ar2
    elementType: line
    bounds: [613, 188, 36, 24]
    viewBox: [36, 24]
    points: "0,12 30,12"
    arrow: [null, arrow]
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: c3
    elementType: shape
    bounds: [650, 128, 250, 150]
