pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [70, 50, 820, 20]
    content:
      fontSize: 12
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "КАРАНТИН И ПОСТЕЛЬНЫЕ · ВЫБОР НЕ ОТМЕНЯЕТСЯ"
  - elementId: title
    elementType: text
    bounds: [70, 80, 820, 56]
    content:
      fontSize: 28
      bold: true
      color: "$text"
      fontFamily: PT Serif
      text: "Два варианта на подносе, не вторая линия"
  - elementId: lead
    elementType: text
    bounds: [70, 148, 820, 44]
    content:
      fontSize: 14
      lineHeight: 1.4
      color: "$text"
      fontFamily: Noto Sans
      text: "Столовая закрыта — выбор меняет форму, не исчезает. 11% жителей не доходят до линии."
  - elementId: l1
    elementType: text
    bounds: [70, 210, 420, 200]
    content:
      fontSize: 13
      lineHeight: 1.55
      color: "$text"
      fontFamily: Noto Sans
      text: "<p><strong>Как выглядит выбор в комнате</strong></p><p>1. Две порции на подносе или картинки на двери</p><p>2. Стандартный вариант всегда есть</p><p>3. Журнал заказа — на посту</p><p>4. Горячее доходит до палаты: замер на последней выдаче</p>"
  - elementId: l2
    elementType: text
    bounds: [500, 210, 400, 200]
    content:
      fontSize: 13
      lineHeight: 1.55
      color: "$text"
      fontFamily: Noto Sans
      text: "<p><strong>План Б до вспышки, не утром</strong></p><p>1. Кто готовит, если не вышла кухня</p><p>2. Питьё по графику, раздельная посуда</p><p>3. Витаминизация — только врач</p><p>4. Лица на фото линии не попадают</p>"
  - elementId: warn
    elementType: shape
    bounds: [60, 420, 840, 50]
    shapeName: rect
    cornerRadius: 12
    fill:
      type: solid
      color: "$soft"
  - elementId: warnt
    elementType: text
    bounds: [80, 428, 800, 40]
    content:
      fontSize: 12.5
      lineHeight: 1.4
      color: "$primary"
      bold: true
      fontFamily: Noto Sans
      text: "Если вариативность есть только в столовой — это привилегия ходячих. Форма плана Б — приложение 45."
  - elementId: src
    elementType: text
    bounds: [70, 480, 820, 40]
    content:
      fontSize: 10
      color: "$muted"
      fontFamily: Noto Sans
      text: "Источники: разделы 18.11 и 20.11; статистика контингента S004. План Б — приложение 45."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "#A8A294"
      align: [right, top]
      text: "29"
