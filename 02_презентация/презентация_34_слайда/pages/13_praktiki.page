pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ЭТО УЖЕ РАБОТАЕТ В РОССИИ"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Подтверждено: шесть действующих российских практик"
  - elementId: line
    elementType: shape
    bounds: [60, 108, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: list
    elementType: text
    bounds: [60, 130, 840, 280]
    content:
      fontSize: 14.5
      lineHeight: 1.55
      text: |
        <p><strong>Болотнинский ПНИ</strong> (Новосибирская обл.) — выбор из двух вариантов на завтрак и обед несколько раз в неделю; перечень определяет диетсестра. <span style="color:$muted">Ступень 1.</span></p>
        <p style="margin-top:6px"><strong>Успенский ПНИ</strong> (Новосибирская обл.) — выбор по всем основным позициям, ежедневно, все отделения. <span style="color:$muted">Ступень 2.</span></p>
        <p style="margin-top:6px"><strong>Усть-Илимский ДСО</strong> (Иркутская обл.) — поэтапно, с опроса; участник семинара.</p>
        <p style="margin-top:6px"><strong>Серафимовский ДСО</strong> (Санкт-Петербург) — заказ накануне для части жителей; оборудование и доп. сотрудники; полный переход затруднителен. <span style="color:$muted">Дом докладчика.</span></p>
        <p style="margin-top:6px"><strong>Иркутская область</strong> — масштабирование на регион: два первых, два вторых, гарниры — ежедневно.</p>
        <p style="margin-top:6px"><strong>ДДСОЛ</strong> — 14-дневное меню плюс совет по питанию из жителей.</p>
  - elementId: rule
    elementType: shape
    bounds: [60, 424, 200, 2]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: bottom
    elementType: text
    bounds: [60, 440, 840, 40]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      lineHeight: 1.4
      text: "Новость — факт сообщения, не аудит. Три кейса стартовали без новых денег; Серафимовский публично назвал оборудование, ставки и пределы полного перехода."
  - elementId: src
    elementType: text
    bounds: [60, 505, 760, 24]
    content:
      style: "$small"
      text: "Источник: официальные сайты и gov.spb.ru/news/302216, проверено 17.08.2026 (S015–S019, S023); Успенский, Усть-Илимский и Серафимовский — в этом зале"
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "15"
