pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ИНТЕРАКТИВ · БЛАНК В ПАКЕТЕ"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Экспресс-аудит: отвечаем про вчера"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: lead
    elementType: text
    bounds: [60, 122, 840, 36]
    content:
      fontSize: 16
      color: "#4A463C"
      text: "Десять вопросов — на бланке в руках (элемент 11). На экране — только шкала."
  - elementId: s0
    elementType: shape
    bounds: [60, 176, 200, 140]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: s0t
    elementType: text
    bounds: [76, 192, 168, 108]
    content:
      fontSize: 15
      lineHeight: 1.35
      text: "<p><strong>0–3</strong></p><p>Ступень 0 или ниже</p>"
  - elementId: s1
    elementType: shape
    bounds: [273, 176, 200, 140]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: s1t
    elementType: text
    bounds: [289, 192, 168, 108]
    content:
      fontSize: 15
      lineHeight: 1.35
      text: "<p><strong>4–6</strong></p><p>Элементы есть, системы нет</p>"
  - elementId: s2
    elementType: shape
    bounds: [486, 176, 200, 140]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: s2t
    elementType: text
    bounds: [502, 192, 168, 108]
    content:
      fontSize: 15
      lineHeight: 1.35
      text: "<p><strong>7–8</strong></p><p>Ступень 1–2, уязвимая</p>"
  - elementId: s3
    elementType: shape
    bounds: [700, 176, 200, 140]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$primary"}
  - elementId: s3t
    elementType: text
    bounds: [716, 192, 168, 108]
    content:
      fontSize: 15
      lineHeight: 1.35
      color: "#FFFFFF"
      text: "<p><strong>9–10</strong></p><p>Система работает</p>"
  - elementId: rule
    elementType: text
    bounds: [60, 340, 840, 80]
    content:
      fontSize: 16
      lineHeight: 1.4
      text: "<p><strong>«Не знаю» честнее «да».</strong> По памяти результат завышен на 1–2 балла.</p><p style=\"margin-top:8px\">Через 90 дней пилота аудит повторяется — разница баллов и есть отчёт учредителю.</p>"
  - elementId: src
    elementType: text
    bounds: [60, 500, 780, 28]
    content:
      style: "$small"
      text: "Семинарский пакет, элемент 11; раздел 22 доклада."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "37"
