pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ДИАГНОЗ · ЧТО ЗНАЧИТ «НАКОРМИТЬ»"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Одна тарелка — шесть измерений. Провал любого — недоедание или конфликт"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: m1
    elementType: shape
    bounds: [60, 134, 266, 96]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: m1n
    elementType: text
    bounds: [78, 146, 50, 26]
    content:
      fontSize: 18
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "1"
  - elementId: m1t
    elementType: text
    bounds: [78, 176, 234, 44]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "<strong>Достаточность</strong> — порция, выданная и не съеденная, достаточностью не является"
  - elementId: m2
    elementType: shape
    bounds: [347, 134, 266, 96]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: m2n
    elementType: text
    bounds: [365, 146, 50, 26]
    content:
      fontSize: 18
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "2"
  - elementId: m2t
    elementType: text
    bounds: [365, 176, 234, 44]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "<strong>Безопасность</strong> — санитарная, клиническая (текстуры), поведенческая (пика)"
  - elementId: m3
    elementType: shape
    bounds: [634, 134, 266, 96]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: m3n
    elementType: text
    bounds: [652, 146, 50, 26]
    content:
      fontSize: 18
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "3"
  - elementId: m3t
    elementType: text
    bounds: [652, 176, 234, 44]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "<strong>Удовольствие</strong> — невкусная еда съедается хуже: вкус — фактор потребления"
  - elementId: m4
    elementType: shape
    bounds: [60, 244, 266, 96]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: m4n
    elementType: text
    bounds: [78, 256, 50, 26]
    content:
      fontSize: 18
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "4"
  - elementId: m4t
    elementType: text
    bounds: [78, 286, 234, 44]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "<strong>Социальность</strong> — общий стол персонала и жителей: бесплатный мониторинг «он сегодня не жуёт»"
  - elementId: m5
    elementType: shape
    bounds: [347, 244, 266, 96]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: m5n
    elementType: text
    bounds: [365, 256, 50, 26]
    content:
      fontSize: 18
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "5"
  - elementId: m5t
    elementType: text
    bounds: [365, 286, 234, 44]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "<strong>Самостоятельность</strong> — навык, который потом нужен в сопровождаемом проживании"
  - elementId: m6
    elementType: shape
    bounds: [634, 244, 266, 96]
    shapeName: rect
    fill: {type: solid, color: "#F4E7D8", radius: 8}
  - elementId: m6n
    elementType: text
    bounds: [652, 256, 50, 26]
    content:
      fontSize: 18
      bold: true
      color: "$risk"
      fontFamily: PT Serif
      text: "6"
  - elementId: m6t
    elementType: text
    bounds: [652, 286, 234, 44]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.35
      fontFamily: Noto Sans
      text: "<strong>Выбор</strong> — единственное измерение, которое нельзя делегировать системе"
  - elementId: takeaway
    elementType: text
    bounds: [60, 368, 840, 108]
    content:
      fontSize: 15
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: |
        <p><strong>Каждое измерение проверяется за десять минут, без рубля:</strong></p>
        <p>· безопасность — постоять у линии и посмотреть, кто из списка риска ест вне поля зрения смены;</p>
        <p>· физиология — сверить ужин и завтрак с часами; · психология — спросить вечером «что сегодня было на обед»;</p>
        <p>· социальность — ест ли персонал вместе с жителями; · право — проверка реальности выбора; · экономика — сырьевая строка за минуту деления.</p>
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 7 — шесть измерений одной тарелки"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 136, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "6"
