pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 700, 16]
    content:
      style: "$kicker"
      text: "ПРОВЕРКА РЕАЛЬНОСТИ · РАЗДЕЛЫ 8.3 И 22"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Пять критериев. Без них «вариативность» формальна"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: r1
    elementType: shape
    bounds: [60, 124, 840, 58]
    shapeName: rect
    cornerRadius: 12
    fill: {type: solid, color: "$soft"}
  - elementId: t1
    elementType: text
    bounds: [80, 134, 800, 40]
    content:
      fontSize: 16
      text: "<p><strong>1. Доступность.</strong> Вариант Б ещё есть, когда подходит житель.</p>"
  - elementId: r2
    elementType: shape
    bounds: [60, 190, 840, 58]
    shapeName: rect
    cornerRadius: 12
    fill: {type: solid, color: "$soft"}
  - elementId: t2
    elementType: text
    bounds: [80, 200, 800, 40]
    content:
      fontSize: 16
      text: "<p><strong>2. Равноценность.</strong> Замена по таблице, а не «гречка или ничего».</p>"
  - elementId: r3
    elementType: shape
    bounds: [60, 256, 840, 58]
    shapeName: rect
    cornerRadius: 12
    fill: {type: solid, color: "$soft"}
  - elementId: t3
    elementType: text
    bounds: [80, 266, 800, 40]
    content:
      fontSize: 16
      text: "<p><strong>3. Информированность.</strong> Житель знает о выборе: слово, показ, картинка.</p>"
  - elementId: r4
    elementType: shape
    bounds: [60, 322, 840, 58]
    shapeName: rect
    cornerRadius: 12
    fill: {type: solid, color: "$soft"}
  - elementId: t4
    elementType: text
    bounds: [80, 332, 800, 40]
    content:
      fontSize: 16
      text: "<p><strong>4. Уважение.</strong> Выбранное подаётся. «Для вашей пользы» — не норма.</p>"
  - elementId: r5
    elementType: shape
    bounds: [60, 388, 840, 58]
    shapeName: rect
    cornerRadius: 12
    fill: {type: solid, color: "$soft"}
  - elementId: t5
    elementType: text
    bounds: [80, 398, 800, 40]
    content:
      fontSize: 16
      text: "<p><strong>5. Учёт.</strong> Выбор записан и меняет завтрашние объёмы.</p>"
  - elementId: src
    elementType: text
    bounds: [60, 500, 780, 28]
    content:
      style: "$small"
      text: "Источник: разделы 8.3 и 22; чек-лист — приложение 24. Проверка — к вчерашнему дню, не к бумаге."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "14"
