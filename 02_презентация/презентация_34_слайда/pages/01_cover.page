pageType: cover
background:
  type: solid
  color: "$dark"
elements:
  - elementId: spark
    elementType: text
    bounds: [70, 56, 40, 34]
    content:
      fontSize: 24
      color: "$accent"
      fontFamily: Noto Sans
      text: "✦"
  - elementId: brand
    elementType: text
    bounds: [112, 62, 640, 26]
    content:
      fontSize: 15
      color: "$cream"
