pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ЧЕРЕЗ ГОД · ПИСЬМО ДИРЕКТОРУ"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Через год возможны два сценария"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: sA
    elementType: shape
    bounds: [60, 134, 404, 260]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: sAh
    elementType: text
    bounds: [78, 150, 372, 30]
    content:
      fontSize: 15
      bold: true
      color: "$muted"
      fontFamily: Noto Sans
      text: "Сценарий А · Полка"
  - elementId: sAt
    elementType: text
    bounds: [78, 188, 372, 190]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: "Вы вернулись, положили доклад на полку — «сложная тема, но когда-нибудь». Ничего не изменилось, кроме одного: теперь вы знаете, что у коллег работает. И каждая жалоба на еду читается иначе."
  - elementId: sB
    elementType: shape
    bounds: [496, 134, 404, 260]
    shapeName: rect
    fill: {type: solid, color: "#E4EFE9", radius: 8}
  - elementId: sBh
    elementType: text
    bounds: [514, 150, 372, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Сценарий Б · Система"
  - elementId: sBt
    elementType: text
    bounds: [514, 188, 372, 190]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: "Неделя замера, совет, пилот в одном отделении. Панель чисел лежит у учредителя. Два варианта второго — обычный день, который уже никто не замечает, как не замечают водопровод."
  - elementId: key
    elementType: shape
    bounds: [60, 414, 840, 78]
    shapeName: rect
    fill: {type: solid, color: "#F4E7D8", radius: 8}
  - elementId: keyt
    elementType: text
    bounds: [84, 426, 800, 56]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "<strong>Разница между сценариями — не деньги</strong> (пилот дешевле одного ремонтного дня), <strong>не разрешения</strong> (замеры не требуют согласований), <strong>не люди</strong> (смена та же). Разница — первая неделя. Первая неделя дешевле года сомнений."
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 43.5 — письмо директору через год"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 818, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "36"
