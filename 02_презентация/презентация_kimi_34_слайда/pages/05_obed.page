pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navy"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "#FFFFFF", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПУТЬ}
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: pagenum
    elementType: text
    bounds: [780, 512, 160, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 05 / 34"}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: 'Один обед — пять конфликтов; ни один из них — не про повара'
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      wrap: false
      text: 'Точка входа доклада: разобрать один обед — и увидеть систему целиком'
  - elementId: source
    elementType: text
    bounds: [60, 512, 700, 14]
    content: {style: "$foot", text: 'Доклад, раздел 5 — собирательная ситуация; все персонажи вымышлены'}
  - elementId: c0
    elementType: shape
    bounds: [60, 108, 30, 30]
    shapeName: ellipse
    fill: {type: solid, color: "$orange"}
  - elementId: cn0
    elementType: text
    bounds: [60, 108, 30, 30]
    content:
      fontFamily: "Arial"
      align: [center, middle]
      text: |
        <p style="text-align:center"><strong><span style="font-size:12px; color:#FFFFFF">01</span></strong></p>
  - elementId: cr0
    elementType: text
    bounds: [108, 106, 832, 70]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:12px">Очередь против помощи.</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10.5px">Кто ест сам — уже с холодным. Кому нужна помощь — ждёт: четыре сиделки на двенадцать кормимых.</span></p>
  - elementId: sep0
    elementType: line
    bounds: [108, 170, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: c1
    elementType: shape
    bounds: [60, 184, 30, 30]
    shapeName: ellipse
    fill: {type: solid, color: "$orange"}
  - elementId: cn1
    elementType: text
    bounds: [60, 184, 30, 30]
    content:
      fontFamily: "Arial"
      align: [center, middle]
      text: |
        <p style="text-align:center"><strong><span style="font-size:12px; color:#FFFFFF">02</span></strong></p>
  - elementId: cr1
    elementType: text
    bounds: [108, 182, 832, 70]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:12px">«Он опять не ест кашу».</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10.5px">Третий день подряд — и никто не связал это с началом дисфагии. Логопеда в штате нет.</span></p>
  - elementId: sep1
    elementType: line
    bounds: [108, 246, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: c2
    elementType: shape
    bounds: [60, 260, 30, 30]
    shapeName: ellipse
    fill: {type: solid, color: "$orange"}
  - elementId: cn2
    elementType: text
    bounds: [60, 260, 30, 30]
    content:
      fontFamily: "Arial"
      align: [center, middle]
      text: |
        <p style="text-align:center"><strong><span style="font-size:12px; color:#FFFFFF">03</span></strong></p>
  - elementId: cr2
    elementType: text
    bounds: [108, 258, 832, 70]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:12px">Кофе и клозапин.</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10.5px">Две кружки крепкого кофе от родственников — и вечером «плохой день». Кухня об этом не знает.</span></p>
  - elementId: sep2
    elementType: line
    bounds: [108, 322, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: c3
    elementType: shape
    bounds: [60, 336, 30, 30]
    shapeName: ellipse
    fill: {type: solid, color: "$orange"}
  - elementId: cn3
    elementType: text
    bounds: [60, 336, 30, 30]
    content:
      fontFamily: "Arial"
      align: [center, middle]
      text: |
        <p style="text-align:center"><strong><span style="font-size:12px; color:#FFFFFF">04</span></strong></p>
  - elementId: cr3
    elementType: text
    bounds: [108, 334, 832, 70]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:12px">Вторая котлета.</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10.5px">«Вам нельзя, вы полнеете» — хотя ограничение рациона никто не назначал. Сиделка решила за врача.</span></p>
  - elementId: sep3
    elementType: line
    bounds: [108, 398, 832, 1]
    viewBox: [832, 1]
    points: "0,0 832,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: c4
    elementType: shape
    bounds: [60, 412, 30, 30]
    shapeName: ellipse
    fill: {type: solid, color: "$orange"}
  - elementId: cn4
    elementType: text
    bounds: [60, 412, 30, 30]
    content:
      fontFamily: "Arial"
      align: [center, middle]
      text: |
        <p style="text-align:center"><strong><span style="font-size:12px; color:#FFFFFF">05</span></strong></p>
  - elementId: cr4
    elementType: text
    bounds: [108, 410, 832, 70]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:12px">«Приведите журналы в порядок».</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10.5px">Накануне комиссии. Самое опасное из пяти — имитация контроля вместо контроля.</span></p>
