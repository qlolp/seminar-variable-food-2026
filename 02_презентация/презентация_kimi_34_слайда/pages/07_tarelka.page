    fill: {type: solid, color: "$navy"}
  - elementId: cn0
    elementType: text
    bounds: [60, 108, 28, 28]
    content:
      fontFamily: "Arial"
      align: [center, middle]
      text: |
        <p style="text-align:center"><strong><span style="font-size:12px; color:#FFFFFF">1</span></strong></p>
  - elementId: ct0
    elementType: text
    bounds: [100, 106, 398, 96]
