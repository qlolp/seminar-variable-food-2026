      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:12px; color:$navy">Достаточность</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10.5px">Порция, выданная и не съеденная, достаточностью не является</span></p>
