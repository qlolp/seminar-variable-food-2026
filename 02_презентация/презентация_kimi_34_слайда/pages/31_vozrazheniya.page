pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navy"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "#FFFFFF", align: [center, middle], text: ПУТЬ}
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: pagenum
    elementType: text
    bounds: [780, 512, 160, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 31 / 34"}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: 'Четырнадцать возражений — у большинства есть рациональное ядро'
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      wrap: false
      text: 'Разговор с сомневающимися: ответы документами, замерами и конструкцией'
  - elementId: source
    elementType: text
    bounds: [60, 512, 700, 14]
    content: {style: "$foot", text: 'Доклад, раздел 37 — четырнадцать возражений; раздел 42 — аутсорсинг'}
  - elementId: l1
    elementType: text
    bounds: [60, 112, 290, 300]
    content:
      style: "$small"
      fontSize: 10.5
      text: |
        <p style="margin-top:7px">· «Не способны выбирать»</p>
        <p style="margin-top:7px">· «Будут очереди»</p>
        <p style="margin-top:7px">· «Это дорого»</p>
        <p style="margin-top:7px">· «Санэпид не разрешит»</p>
        <p style="margin-top:7px">· «Нет диетолога»</p>
        <p style="margin-top:7px">· «Выберут нездоровое»</p>
        <p style="margin-top:7px">· «Выбрал и отказался»</p>
  - elementId: l2
    elementType: text
    bounds: [370, 112, 290, 300]
    content:
      style: "$small"
      fontSize: 10.5
      text: |
        <p style="margin-top:7px">· «Лечебное питание»</p>
        <p style="margin-top:7px">· «Персонал против»</p>
        <p style="margin-top:7px">· «Проверка спросит»</p>
        <p style="margin-top:7px">· «У нас 400 мест»</p>
        <p style="margin-top:7px">· «И так нормально»</p>
        <p style="margin-top:7px">· «Кухня не своя»</p>
        <p style="margin-top:7px">· «1 сентября — новый СанПиН»</p>
  - elementId: a0
    elementType: shape
    bounds: [684, 112, 256, 98]
    shapeName: rect
    fill: {type: solid, color: "$peach"}
  - elementId: at0
    elementType: text
    bounds: [698, 120, 230, 84]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.3
      text: |
        <p><strong><span style="font-size:11px; color:$orange">12 из 14</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:9.5px">снимаются документами, замерами или конструкцией линии: положение, журнал заказа, пары эквивалентов, инструктаж смены.</span></p>
  - elementId: a1
    elementType: shape
    bounds: [684, 222, 256, 98]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
  - elementId: at1
    elementType: text
    bounds: [698, 230, 230, 84]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.3
      text: |
        <p><strong><span style="font-size:11px; color:$orange">№ 13 · «Кухня не своя»</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:9.5px">снимается спецификацией: восемь строк контракта аутсорсинга (раздел 42).</span></p>
  - elementId: a2
    elementType: shape
    bounds: [684, 332, 256, 98]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
  - elementId: at2
    elementType: text
    bounds: [698, 340, 230, 84]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.3
      text: |
        <p><strong><span style="font-size:11px; color:$orange">№ 14 · «Новый СанПиН»</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:9.5px">снимается перепривязкой локальных актов к 4282-26 — модель выбора не меняется.</span></p>
  - elementId: note
    elementType: text
    bounds: [60, 430, 880, 40]
    content:
      style: "$small"
      fontSize: 10
      color: $muted
      text: |
        <p>Каждое возражение разобрано в разделе 37 без издёвки — в большинстве есть рациональное ядро. «Зачем, если и так нормально?» снимается только собственными числами замера.</p>
