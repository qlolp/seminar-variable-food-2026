pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navy"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "#FFFFFF", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПУТЬ}
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: pagenum
    elementType: text
    bounds: [780, 512, 160, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 23 / 34"}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: 'Линия важнее меню: четыре принципа раздачи'
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      wrap: false
      text: 'Точка раздачи — место, где технология встречается с человеком'
  - elementId: source
    elementType: text
    bounds: [60, 512, 700, 14]
    content: {style: "$foot", text: 'Доклад, раздел 20 — точка раздачи; раздел 28 — норма помощи 1:2'}
  - elementId: lb0
    elementType: shape
    bounds: [60, 108, 150, 72]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: lbt0
    elementType: text
    bounds: [72, 108, 126, 72]
    content:
      color: "#FFFFFF"
      fontFamily: "Arial"
      align: [left, middle]
      text: |
        <p><strong><span style="font-size:11px">ПОТОК</span></strong></p>
  - elementId: ld0
    elementType: text
    bounds: [226, 108, 714, 72]
    content:
      style: "$small"
      fontSize: 10.5
      align: [left, middle]
      text: |
        <p>Заказ накануне убирает выбор из очереди. Визуальное меню до линии, маркировка вариантов, направление потока — чтобы не создать пробку и не остудить тарелку.</p>
  - elementId: sep0
    elementType: line
    bounds: [226, 186, 714, 1]
    viewBox: [714, 1]
    points: "0,0 714,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: lb1
    elementType: shape
    bounds: [60, 194, 150, 72]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: lbt1
    elementType: text
    bounds: [72, 194, 126, 72]
    content:
      color: "#FFFFFF"
      fontFamily: "Arial"
      align: [left, middle]
      text: |
        <p><strong><span style="font-size:11px">ПОМОЩЬ</span></strong></p>
  - elementId: ld1
    elementType: text
    bounds: [226, 194, 714, 72]
    content:
      style: "$small"
      fontSize: 10.5
      align: [left, middle]
      text: |
        <p>Еда подаётся под готовую помощь, а не до неё. Ориентир: не более двух полностью кормимых на одного работника. Кто ест сам — не ждёт, пока накормят других.</p>
  - elementId: sep1
    elementType: line
    bounds: [226, 272, 714, 1]
    viewBox: [714, 1]
    points: "0,0 714,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: lb2
    elementType: shape
    bounds: [60, 280, 150, 72]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: lbt2
    elementType: text
    bounds: [72, 280, 126, 72]
    content:
      color: "#FFFFFF"
      fontFamily: "Arial"
      align: [left, middle]
      text: |
        <p><strong><span style="font-size:11px">ВИДИМОСТЬ</span></strong></p>
  - elementId: ld2
    elementType: text
    bounds: [226, 280, 714, 72]
    content:
      style: "$small"
      fontSize: 10.5
      align: [left, middle]
      text: |
        <p>«Почему ему больше?» — конфликт, рождённый на глазах. Порции на линии видны, добавка регламентирована, выбор одного не ущемляет другого.</p>
  - elementId: sep2
    elementType: line
    bounds: [226, 358, 714, 1]
    viewBox: [714, 1]
    points: "0,0 714,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: lb3
    elementType: shape
    bounds: [60, 366, 150, 72]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: lbt3
    elementType: text
    bounds: [72, 366, 126, 72]
    content:
      color: "#FFFFFF"
      fontFamily: "Arial"
      align: [left, middle]
      text: |
        <p><strong><span style="font-size:11px">АТМОСФЕРА</span></strong></p>
  - elementId: ld3
    elementType: text
    bounds: [226, 366, 714, 72]
    content:
      style: "$small"
      fontSize: 10.5
      align: [left, middle]
      text: |
        <p>Раздача — как сервис, а не как выдача. Персонал за общим столом: бесплатный мониторинг «он сегодня не жуёт» и тепло вместо конвейера.</p>
