pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПУТЬ}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: Проблема измерима, решение опробовано, вход — одна неделя замера
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      text: "Маршрут доклада: от одного обеда к системе. Каждый слайд указывает раздел доклада (332 страницы)"
  - elementId: band1
    elementType: shape
    bounds: [60, 108, 280, 22]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: band1t
    elementType: text
    bounds: [70, 108, 270, 22]
    content: {style: "$band", align: [left, middle], text: НАХОДКИ}
  - elementId: col1
    elementType: text
    bounds: [60, 140, 280, 310]
    content:
      style: "$small"
      fontSize: 9.5
      text: |
        <p><strong>174 000+</strong> жителей стационарного соцобслуживания едят по чужому решению</p>
        <p style="margin-top:10px"><strong>Дисфагия</strong> — минимум у каждого пятого; логопеда в типовом ПНИ нет</p>
        <p style="margin-top:10px"><strong>≈15 часов</strong> — типовой ночной интервал без еды: ужин 17:30, завтрак 8:30</p>
        <p style="margin-top:10px"><strong>74 %</strong> жителей недееспособны — выбор нуждается в инструментах, а не в лозунге</p>
  - elementId: band2
    elementType: shape
    bounds: [360, 108, 280, 22]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: band2t
    elementType: text
    bounds: [370, 108, 270, 22]
    content: {style: "$band", align: [left, middle], text: СЛЕДСТВИЯ}
  - elementId: col2
    elementType: text
    bounds: [360, 140, 280, 310]
    content:
      style: "$small"
      fontSize: 9.5
      text: |
        <p><strong>Питание</strong> — ежедневная зона риска, а не бытовой фон: 3–4 контакта в день, каждый день</p>
        <p style="margin-top:10px"><strong>Мономеню</strong> не закрывает ни одно из шести измерений тарелки — только первое</p>
        <p style="margin-top:10px"><strong>Голодная ночь</strong> и «вторая котлета по решению сиделки» — цена неуправляемого стола</p>
        <p style="margin-top:10px"><strong>Главный риск директора</strong> — не внедрение выбора, а отсутствие документов при существующей практике</p>
  - elementId: band3
    elementType: shape
    bounds: [660, 108, 280, 22]
    shapeName: rect
    fill: {type: solid, color: "$orange"}
  - elementId: band3t
    elementType: text
    bounds: [670, 108, 270, 22]
    content: {style: "$band", align: [left, middle], text: ОТВЕТ ДОКЛАДА}
  - elementId: col3
    elementType: text
    bounds: [660, 140, 280, 310]
    content:
      style: "$small"
      fontSize: 9.5
      text: |
        <p><strong>Лестница М0–М5</strong> — вход на любой ступени; М0–М2 подтверждены российской практикой</p>
        <p style="margin-top:10px"><strong>Пары эквивалентов</strong> — сырьё перераспределяется внутри той же продуктовой строки</p>
        <p style="margin-top:10px"><strong>Комплект документов</strong> — положение, журнал заказа, журнал замен, пищевые карты</p>
        <p style="margin-top:10px"><strong>Пилот 90 дней</strong> — одно отделение, замер до и после, оценка по панели чисел</p>
  - elementId: concl
    elementType: shape
    bounds: [60, 458, 880, 34]
    shapeName: rect
    fill: {type: solid, color: "$peach"}
  - elementId: conclbar
    elementType: shape
    bounds: [60, 458, 6, 34]
    shapeName: rect
    fill: {type: solid, color: "$orange"}
  - elementId: conclt
    elementType: text
    bounds: [78, 458, 850, 34]
    content:
      fontSize: 11.5
      bold: true
      color: "$ink"
      fontFamily: Arial
      align: [left, middle]
      text: "Вывод: вариативность — это организация и документы, а не вторая кухня. Старт — семидневный замер, не требующий согласований."
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: source
    elementType: text
    bounds: [60, 512, 640, 14]
    content: {style: "$foot", text: "Источник: доклад «Не просто накормить»; структура и числа — по разделам 5–43"}
  - elementId: pagenum
    elementType: text
    bounds: [800, 512, 140, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 02 / 34"}
