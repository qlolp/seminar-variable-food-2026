pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navy"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "#FFFFFF", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПУТЬ}
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: pagenum
    elementType: text
    bounds: [780, 512, 160, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 26 / 34"}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: 'Отходы — единственная честная «экономия» выбора'
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      wrap: false
      text: 'Не обещать, а замерить: деньги видны на весах, а не в презентации'
  - elementId: source
    elementType: text
    bounds: [60, 512, 700, 14]
    content: {style: "$foot", text: 'Доклад, раздел 29.4 — отходы; форма семидневного замера — приложение 25'}
  - elementId: b1
    elementType: shape
    bounds: [60, 112, 280, 120]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
  - elementId: b1t
    elementType: text
    bounds: [74, 120, 254, 104]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.3
      text: |
        <p><strong><span style="font-size:26px; color:$navy">36 кг</span></strong></p>
        <p style="margin-top:6px"><span style="font-size:10px">остатков в день: 80 г × 3 приёма × 150 жителей</span></p>
  - elementId: b2
    elementType: shape
    bounds: [360, 112, 280, 120]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
  - elementId: b2t
    elementType: text
    bounds: [374, 120, 254, 104]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.3
      text: |
        <p><strong><span style="font-size:26px; color:$orange">≈ 9 000 ₽</span></strong></p>
        <p style="margin-top:6px"><span style="font-size:10px">в день при условной цене 250 ₽/кг — строка «выброшенных денег»</span></p>
  - elementId: b3
    elementType: shape
    bounds: [660, 112, 280, 120]
    shapeName: rect
    fill: {type: solid, color: "#FFFFFF"}
  - elementId: b3t
    elementType: text
    bounds: [674, 120, 254, 104]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.3
      text: |
        <p><strong><span style="font-size:26px; color:$navy">7 + 7 дней</span></strong></p>
        <p style="margin-top:6px"><span style="font-size:10px">замер до пилота и через 90 дней — формула доказательства</span></p>
  - elementId: cap
    elementType: text
    bounds: [60, 238, 880, 16]
    content:
      style: "$foot"
      text: |
        <p><span style="font-size:8px">Иллюстративный расчёт · дом на 150 жителей. Цифры условные — порядок действий настоящий.</span></p>
  - elementId: logic
    elementType: text
    bounds: [60, 266, 880, 70]
    content:
      style: "$small"
      fontSize: 10.5
      text: |
        <p><strong>Логика проста:</strong> несъеденная порция — оплаченное сырьё в мусорном ведре. Выбор снижает долю несъеденного, потому что нелюбимые блюда перестают попадать на тарелку.</p>
        <p style="margin-top:6px">Доказательной базы эффекта в наших условиях нет — поэтому формула доклада: замер до и после, а не обещание экономии.</p>
  - elementId: b4
    elementType: shape
    bounds: [60, 346, 880, 100]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: b4t
    elementType: text
    bounds: [76, 354, 850, 84]
    content:
      color: "#FFFFFF"
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:11px">КАК ЗАМЕР ПРЕВРАЩАЕТСЯ В РУБЛИ</span></strong></p>
        <p style="margin-top:8px"><span style="font-size:10px">· три взвешивания в день: выдано · возвращено с тарелок · остатки кухни</span></p>
        <p style="margin-top:4px"><span style="font-size:10px">· топ-3 блюд по остаткам сверяются с циклом меню</span></p>
        <p style="margin-top:4px"><span style="font-size:10px">· масса недельных отходов × закупочная цена килограмма = ваша строка «выброшенных денег»</span></p>
