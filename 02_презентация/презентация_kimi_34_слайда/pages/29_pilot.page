    elementType: text
    bounds: [78, 398, 850, 40]
    content:
      color: $ink
      fontFamily: "Arial"
      align: [left, middle]
      lineHeight: 1.35
      text: |
        <p><span style="font-size:10.5px"><strong>«Без новой сметы» не значит «без затрат»:</strong> сначала замер, документы и обучение — потом выбор на линии. Пилот дешевле одного ремонтного дня.</span></p>
