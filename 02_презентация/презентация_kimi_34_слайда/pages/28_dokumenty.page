  - elementId: d1
    elementType: text
    bounds: [60, 190, 430, 46]
    content:
      style: "$small"
      fontSize: 9.5
      align: [left, middle]
      text: |
        <p>· Меню с вариантами — пары эквивалентов внутри норм и раскладок</p>
  - elementId: dsep1
