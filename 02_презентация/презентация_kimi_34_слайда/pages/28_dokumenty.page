    bounds: [60, 340, 430, 46]
    content:
      style: "$small"
      fontSize: 9.5
      align: [left, middle]
      text: |
        <p>· Пищевые карты жителей — ограничения, текстуры, кофеиновая строка</p>
  - elementId: dsep4
