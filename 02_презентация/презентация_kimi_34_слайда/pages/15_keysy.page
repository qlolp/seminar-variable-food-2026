pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navy"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "#FFFFFF", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПУТЬ}
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: pagenum
    elementType: text
    bounds: [780, 512, 160, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 15 / 34"}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: 'Четыре публичных кейса — и один из них назвал цену'
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      wrap: false
      text: 'Российская практика уже существует: модели М0–М2 подтверждены, а не предположены'
  - elementId: source
    elementType: text
    bounds: [60, 512, 700, 14]
    content: {style: "$foot", text: 'Доклад, раздел 25 — четыре подтверждённых кейса; источники S015–S018, S030'}
  - elementId: tbl
    elementType: table
    bounds: [60, 106, 880, 250]
    columnWidths: [0.26, 0.20, 0.12, 0.42]
    rowHeights: [0.14, 0.215, 0.215, 0.215, 0.215]
    style: "$default"
    rows:
      - - text: "КЕЙС"
        - text: "РЕГИОН · СТАРТ"
        - text: "МОДЕЛЬ"
        - text: "ЧТО СДЕЛАНО"
      - - text: "<p><strong>Болотнинский ПНИ</strong></p>"
        - text: "Новосибирская обл., с 2024"
        - text: "<p><strong><span style=\"color:$orange\">М1</span></strong></p>"
        - text: "Выбор из двух на завтраке и обеде, несколько раз в неделю. Перечень пар определяет диетсестра."
      - - text: "<p><strong>Успенский ПНИ</strong></p>"
        - text: "Новосибирская обл., с 2024"
        - text: "<p><strong><span style=\"color:$orange\">М2</span></strong></p>"
        - text: "Два вторых, два салата, два напитка — ежедневно, все отделения. «Страхи не подтвердились»."
      - - text: "<p><strong>Усть-Илимский ДСО</strong></p>"
        - text: "Иркутская обл., с 09.2024"
        - text: "<p><strong><span style=\"color:$orange\">М1–М2</span></strong></p>"
        - text: "Начали с опроса предпочтений жителей; выбор встроен в действующий поток."
      - - text: "<p><strong>ДСО «Серафимовский»</strong></p>"
        - text: "Санкт-Петербург, 2025"
        - text: "<p><strong><span style=\"color:$orange\">М1–М2</span></strong></p>"
        - text: "Дом докладчика. Старт не был «без новых денег»: оборудование и ставки названы прямо."
  - elementId: note
    elementType: shape
    bounds: [60, 372, 880, 52]
    shapeName: rect
    fill: {type: solid, color: "$peach"}
  - elementId: notet
    elementType: text
    bounds: [74, 378, 852, 40]
    content:
      style: "$small"
      fontSize: 10
      text: |
        <p><strong>Иркутская область — единственный заявленный случай масштаба области</strong> (S018, источник вторичный).</p>
        <p style="margin-top:4px">В зале — носители опыта: Успенский ПНИ, Усть-Илимск, «Серафимовский». Дальше говорим не о гипотезе, а о практике, которая уже в этом зале.</p>
  - elementId: n2
    elementType: text
    bounds: [60, 436, 880, 40]
    content:
      style: "$small"
      fontSize: 9.5
      color: $muted
      text: |
        <p>Честность про «Серафимовский»: новость учредителя — факт сообщения, не аудит. Цена старта названа, а не спрятана.</p>
