pageType: chapter
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: bignum
    elementType: text
    bounds: [60, 150, 300, 90]
    content:
      fontSize: 72
      bold: true
      color: "$orange"
      fontFamily: Arial
      wrap: false
      text: "01"
  - elementId: sectitle
    elementType: text
    bounds: [60, 252, 760, 44]
    content:
      fontSize: 32
      bold: true
      color: "$navy"
      fontFamily: Arial
      wrap: false
      text: СИТУАЦИЯ
  - elementId: secsub
    elementType: text
    bounds: [60, 306, 760, 40]
    content:
      style: "$sub"
      fontSize: 12.5
      text: "Масштаб · Один обед — пять конфликтов · Кто за столом · Шесть измерений тарелки · Клинические риски"
  - elementId: secline
    elementType: line
    bounds: [60, 288, 200, 2]
    viewBox: [200, 2]
    points: "0,1 200,1"
    curve: sharp
    border: {style: solid, width: 2, color: "$orange"}
  - elementId: pagenum
    elementType: text
    bounds: [800, 512, 140, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 03 / 34"}
