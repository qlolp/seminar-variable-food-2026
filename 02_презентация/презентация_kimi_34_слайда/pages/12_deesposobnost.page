pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 10, 540]
    shapeName: rect
    fill: {type: solid, color: "$rail"}
  - elementId: nav1
    elementType: shape
    bounds: [30, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav1t
    elementType: text
    bounds: [30, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: СИТУАЦИЯ}
  - elementId: nav2
    elementType: shape
    bounds: [214, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navy"}
  - elementId: nav2t
    elementType: text
    bounds: [214, 14, 172, 20]
    content: {style: "$navtext", color: "#FFFFFF", align: [center, middle], text: ПРАВО}
  - elementId: nav3
    elementType: shape
    bounds: [398, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav3t
    elementType: text
    bounds: [398, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ТЕХНОЛОГИЯ}
  - elementId: nav4
    elementType: shape
    bounds: [582, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav4t
    elementType: text
    bounds: [582, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ДЕНЬГИ}
  - elementId: nav5
    elementType: shape
    bounds: [766, 14, 180, 20]
    shapeName: homePlate
    adjustments: [25000]
    fill: {type: solid, color: "$navoff"}
  - elementId: nav5t
    elementType: text
    bounds: [766, 14, 172, 20]
    content: {style: "$navtext", color: "$navofftext", align: [center, middle], text: ПУТЬ}
  - elementId: footline
    elementType: line
    bounds: [60, 506, 880, 1]
    viewBox: [880, 1]
    points: "0,0 880,0"
    curve: sharp
    border: {style: solid, width: 0.75, color: "$line"}
  - elementId: pagenum
    elementType: text
    bounds: [780, 512, 160, 14]
    content: {style: "$foot", align: [right, top], text: "Не просто накормить · 12 / 34"}
  - elementId: title
    elementType: text
    bounds: [60, 42, 880, 30]
    content:
      style: "$h1"
      wrap: false
      text: '74 % жителей недееспособны — но выбор блюда не сделка'
  - elementId: subtitle
    elementType: text
    bounds: [60, 76, 880, 18]
    content:
      style: "$sub"
      wrap: false
      text: 'Дееспособность определяет инструмент выбора, а не его наличие'
  - elementId: source
    elementType: text
    bounds: [60, 512, 700, 14]
    content: {style: "$foot", text: 'Доклад, раздел 16 — дееспособность и бытовая воля; ст. 29 ГК РФ'}
  - elementId: big
    elementType: text
    bounds: [60, 120, 260, 120]
    content:
      fontFamily: "Arial"
      wrap: false
      text: |
        <p><strong><span style="font-size:60px; color:$orange">74 %</span></strong></p>
  - elementId: bigd
    elementType: text
    bounds: [60, 236, 260, 150]
    content:
      style: "$small"
      fontSize: 10.5
      text: |
        <p>жителей ПНИ признаны недееспособными. Признание означает опеку над сделками — но <strong>не отменяет бытовых предпочтений</strong>.</p>
  - elementId: p0
    elementType: shape
    bounds: [356, 112, 4, 76]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: pt0
    elementType: text
    bounds: [374, 112, 566, 76]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:11px; color:$navy">Ст. 29 ГК РФ</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10px">Сделки совершает опекун. Выбор каши — не сделка: юридических последствий у предпочтения блюда нет.</span></p>
  - elementId: p1
    elementType: shape
    bounds: [356, 204, 4, 76]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: pt1
    elementType: text
    bounds: [374, 204, 566, 76]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:11px; color:$navy">Мнение учитывается</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10px">Закон требует учитывать мнение недееспособного в вопросах, затрагивающих его интересы, — еда такой вопрос.</span></p>
  - elementId: p2
    elementType: shape
    bounds: [356, 296, 4, 76]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: pt2
    elementType: text
    bounds: [374, 296, 566, 76]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:11px; color:$navy">Инструмент по статусу</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10px">Сохранный интеллект — словесный выбор; деменция — показ карточек; неговорящие — вчерашний показ и пищевая карта.</span></p>
  - elementId: p3
    elementType: shape
    bounds: [356, 388, 4, 76]
    shapeName: rect
    fill: {type: solid, color: "$navy"}
  - elementId: pt3
    elementType: text
    bounds: [374, 388, 566, 76]
    content:
      color: $ink
      fontFamily: "Arial"
      lineHeight: 1.35
      text: |
        <p><strong><span style="font-size:11px; color:$navy">Опека ≠ молчание</span></strong></p>
        <p style="margin-top:4px"><span style="font-size:10px">Опекун защищает от сделок, а не от обеда. Система обязана слышать бытовую волю жителя.</span></p>
