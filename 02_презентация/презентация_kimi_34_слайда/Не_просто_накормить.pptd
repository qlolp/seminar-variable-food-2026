version: v2
title: Не просто накормить — вариативное питание в домах социального обслуживания
size: [960, 540]
theme:
  colors:
    bg: "#FAF8F6"
    ink: "#4D4D55"
    muted: "#7A7A85"
    orange: "#FF6600"
    rail: "#FF5703"
    navy: "#172856"
    blue: "#25408B"
    cyan: "#579DB7"
    peach: "#FFE0CC"
    lightblue: "#96C2D2"
    gray: "#A6A6A6"
    line: "#D9D9D9"
    green: "#008000"
    red: "#C00000"
    navoff: "#E9E3DB"
    navofftext: "#8A8580"
    yellowrow: "#FFF3D6"
  textStyles:
    kicker:
      fontSize: 10
      color: "$navy"
      bold: true
      letterSpacing: 2
      fontFamily: Arial
    h1:
      fontSize: 22
      bold: true
      color: "$orange"
      fontFamily: Arial
      lineHeight: 1.15
    sub:
      fontSize: 11.5
      color: "$muted"
      fontFamily: Arial
      lineHeight: 1.3
    body:
      fontSize: 10.5
      color: "$ink"
      fontFamily: Arial
      lineHeight: 1.4
    small:
      fontSize: 9
      color: "$ink"
      fontFamily: Arial
      lineHeight: 1.35
    foot:
      fontSize: 7
      color: "$gray"
      fontFamily: Arial
      lineHeight: 1.25
    band:
      fontSize: 11
      bold: true
      color: "#FFFFFF"
      letterSpacing: 1
      fontFamily: Arial
    navtext:
      fontSize: 8
      bold: true
      letterSpacing: 1
      fontFamily: Arial
  tableStyles:
    default:
      cellStyle:
        fontSize: 9.5
        color: "$ink"
        fontFamily: Arial
        align: [left, middle]
        lineHeight: 1.3
        border:
          - {style: solid, width: 0.75, color: "$line"}
          - {style: solid, width: 0.75, color: "$line"}
          - {style: solid, width: 0.75, color: "$line"}
          - {style: solid, width: 0.75, color: "$line"}
      firstRowStyle:
        fill: {type: solid, color: "$navy"}
        color: "#FFFFFF"
        bold: true
        fontSize: 9
pages:
  - pages/01_cover.page
  - pages/02_summary.page
  - pages/03_s1.page
  - pages/04_masshtab.page
  - pages/05_obed.page
  - pages/06_stol.page
  - pages/07_tarelka.page
  - pages/08_riski.page
  - pages/09_s2.page
  - pages/10_pravo.page
  - pages/11_sanpin.page
  - pages/12_deesposobnost.page
  - pages/13_s3.page
  - pages/14_lestnica.page
  - pages/15_keysy.page
  - pages/16_mir.page
  - pages/17_pary.page
  - pages/18_zhurnal.page
  - pages/19_lekarstva.page
  - pages/20_disfagiya.page
  - pages/21_ves.page
  - pages/22_noch.page
  - pages/23_liniya.page
  - pages/24_s4.page
  - pages/25_cena.page
  - pages/26_othody.page
  - pages/27_s5.page
  - pages/28_dokumenty.page
  - pages/29_pilot.page
  - pages/30_karta.page
  - pages/31_vozrazheniya.page
  - pages/32_pervyj_shag.page
  - pages/33_voprosy.page
  - pages/34_final.page
