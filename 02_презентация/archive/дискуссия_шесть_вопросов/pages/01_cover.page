pageType: cover
background:
  type: solid
  color: "$dark"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: panel
    elementType: shape
    bounds: [620, 0, 340, 540]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: motif
    elementType: shape
    bounds: [700, -90, 320, 320]
    shapeName: ellipse
    opacity: 0.22
    fill: {type: solid, color: "$mint"}
  - elementId: motif2
    elementType: shape
    bounds: [780, 360, 240, 240]
    shapeName: ellipse
    opacity: 0.14
    fill: {type: solid, color: "$accent"}
  - elementId: goldbar
    elementType: shape
    bounds: [48, 56, 88, 6]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: brand
    elementType: text
    bounds: [48, 76, 540, 22]
    content:
      fontSize: 13
      color: "$accent"
      letterSpacing: 3
      bold: true
      fontFamily: Noto Sans
      text: "ПРОСТРАНСТВО НОВЫХ ИДЕЙ 2.0"
  - elementId: kicker
    elementType: text
    bounds: [48, 128, 540, 18]
    content:
      fontSize: 11
      color: "$darkmuted"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ДИСКУССИЯ · 26 АВГУСТА · 14:00–15:30"
  - elementId: title
    elementType: text
    bounds: [48, 158, 540, 120]
    content:
      fontSize: 40
      bold: true
      color: "$cream"
      lineHeight: 1.08
      fontFamily: PT Serif
      text: "Организация питания: опыт реализации проектов"
  - elementId: subtitle
    elementType: text
    bounds: [48, 296, 540, 84]
    content:
      fontSize: 15
      color: "$sand"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Шесть вопросов — от права проживающего до нормирования цен. Два дома одного учредителя, разные маршруты к выбору."
  - elementId: ex1
    elementType: text
    bounds: [48, 404, 540, 30]
    content:
      fontSize: 13
      color: "$cream"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Чистяков Е. В.</strong> · ГАСУСОН ДСО «Серафимовский»"
  - elementId: ex2
    elementType: text
    bounds: [48, 436, 540, 30]
    content:
      fontSize: 13
      color: "$cream"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Нурбаев Т. А.</strong> · ГБСУСОН ДСО «Тесовый берег»"
  - elementId: s1n
    elementType: text
    bounds: [656, 96, 270, 54]
    content:
      fontSize: 40
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "6"
  - elementId: s1l
    elementType: text
    bounds: [656, 148, 270, 22]
    content:
      fontSize: 13
      color: "$sand"
      fontFamily: Noto Sans
      text: "вопросов · 90 минут"
  - elementId: s2n
    elementType: text
    bounds: [656, 196, 270, 54]
    content:
      fontSize: 40
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "17.12"
  - elementId: s2l
    elementType: text
    bounds: [656, 248, 270, 22]
    content:
      fontSize: 13
      color: "$sand"
      fontFamily: Noto Sans
      text: "раздел доклада — ответы"
  - elementId: s3n
    elementType: text
    bounds: [656, 296, 270, 54]
    content:
      fontSize: 40
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "2"
  - elementId: s3l
    elementType: text
    bounds: [656, 348, 270, 22]
    content:
      fontSize: 13
      color: "$sand"
      fontFamily: Noto Sans
      text: "дома · один учредитель"
  - elementId: foot
    elementType: text
    bounds: [48, 500, 540, 24]
    content:
      fontSize: 11
      color: "$darkmuted"
      fontFamily: Noto Sans
      text: "Площадка № 2 — ДСО «Тесовый берег» · модераторы сессии · раздел 17.12–17.13 доклада"
