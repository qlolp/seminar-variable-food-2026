pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ТЕХНОЛОГИЯ · ЛИНИЯ РАЗДАЧИ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Линия важнее меню: четыре принципа раздачи"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: l1
    elementType: shape
    bounds: [60, 134, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: l1h
    elementType: text
    bounds: [78, 148, 372, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Поток"
  - elementId: l1t
    elementType: text
    bounds: [78, 182, 372, 96]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Заказ накануне убирает выбор из очереди. Визуальное меню до линии, маркировка вариантов, направление потока — так, чтобы не создать пробку и не остудить тарелку."
  - elementId: l2
    elementType: shape
    bounds: [496, 134, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: l2h
    elementType: text
    bounds: [514, 148, 372, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Помощь"
  - elementId: l2t
    elementType: text
    bounds: [514, 182, 372, 96]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Еда подаётся под готовую помощь, а не до неё. Ориентир: не более двух полностью кормимых на одного работника. Кто ест сам — не ждёт, пока накормят других."
  - elementId: l3
    elementType: shape
    bounds: [60, 306, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: l3h
    elementType: text
    bounds: [78, 320, 372, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Видимость"
  - elementId: l3t
    elementType: text
    bounds: [78, 354, 372, 96]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "«Почему ему больше?» — конфликт, который рождается на глазах. Порции на линии видны, добавка регламентирована, выбор одного не ущемляет другого."
  - elementId: l4
    elementType: shape
    bounds: [496, 306, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: l4h
    elementType: text
    bounds: [514, 320, 372, 30]
    content:
      fontSize: 15
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Атмосфера"
  - elementId: l4t
    elementType: text
    bounds: [514, 354, 372, 96]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Раздача — как сервис, а не как выдача. Персонал за общим столом: это бесплатный мониторинг «он сегодня не жуёт» и тепло вместо конвейера."
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 20 — точка раздачи; раздел 28 — норма помощи"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 477, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "21"
