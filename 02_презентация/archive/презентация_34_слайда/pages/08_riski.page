pageType: content
background:
  type: solid
  color: "$dark"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.16
    fill: {type: solid, color: "$mint"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$accent"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ПОЧЕМУ ЭТО ВАЖНО · КЛИНИЧЕСКИЕ РИСКИ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$cream"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Четыре числа, которые делают тему стола клинической"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: r1
    elementType: text
    bounds: [60, 136, 400, 88]
    content:
      fontSize: 44
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "21,9–69,5 %"
  - elementId: r1l
    elementType: text
    bounds: [60, 228, 400, 52]
    content:
      fontSize: 13.5
      color: "$sand"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "жителей с расстройством глотания — по разным исследованиям. Нижняя граница: <strong>каждый пятый</strong>. Логопеда в типовом ПНИ нет."
  - elementId: r2
    elementType: text
    bounds: [500, 136, 400, 88]
    content:
      fontSize: 44
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "+3,01 кг"
  - elementId: r2l
    elementType: text
    bounds: [500, 228, 400, 52]
    content:
      fontSize: 13.5
      color: "$sand"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "максимальная прибавка веса за <strong>шесть недель</strong> терапии антипсихотиками (мета-анализ 100 РКИ). Прибавка ≥7 % у 76 % на клозапине."
  - elementId: r3
    elementType: text
    bounds: [60, 300, 400, 88]
    content:
      fontSize: 44
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "×7"
  - elementId: r3l
    elementType: text
    bounds: [60, 392, 400, 52]
    content:
      fontSize: 13.5
      color: "$sand"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "смертность от пневмонии при тяжёлых психических расстройствах против популяционной. Аспирация — главный смертельный риск стола."
  - elementId: r4
    elementType: text
    bounds: [500, 300, 400, 88]
    content:
      fontSize: 44
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "4–30 %"
  - elementId: r4l
    elementType: text
    bounds: [500, 392, 400, 52]
    content:
      fontSize: 13.5
      color: "$sand"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "жителей с ночным едением. На отделении в 30 человек — <strong>от одного до девяти</strong> человек каждую ночь."
  - elementId: takeaway
    elementType: text
    bounds: [60, 460, 840, 40]
    content:
      fontSize: 14.5
      color: "$cream"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Всё это — измеримо и управляемо организацией стола:</strong> текстуры, мониторинг веса, журналы, ночная конструкция. Организация питания — часть профилактики преждевременной смертности."
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$darkmuted"
      fontFamily: Noto Sans
      text: "Доклад, разделы 9–14 · источники: реестры MEDICAL_EVIDENCE и INTERNATIONAL_PRACTICES"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 182, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$darkmuted"
      align: [right, top]
      text: "8"
