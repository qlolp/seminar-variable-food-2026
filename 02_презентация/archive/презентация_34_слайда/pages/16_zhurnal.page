pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ТЕХНОЛОГИЯ · ЖУРНАЛ ЗАКАЗА"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Самый частый сбой вариативности — «вариант Б закончился». Лечится тетрадью"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: st1
    elementType: shape
    bounds: [60, 134, 400, 64]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: st1n
    elementType: text
    bounds: [76, 146, 46, 26]
    content:
      fontSize: 17
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "1"
  - elementId: st1t
    elementType: text
    bounds: [128, 146, 318, 42]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Заказ накануне.</strong> Вчерашний выбор определяет сегодняшние объёмы варки"
  - elementId: st2
    elementType: shape
    bounds: [60, 212, 400, 64]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: st2n
    elementType: text
    bounds: [76, 224, 46, 26]
    content:
      fontSize: 17
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "2"
  - elementId: st2t
    elementType: text
    bounds: [128, 224, 318, 42]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Старт 50/50 с резервом.</strong> Через 2–3 месяца статистика стабилизируется"
  - elementId: st3
    elementType: shape
    bounds: [60, 290, 400, 64]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: st3n
    elementType: text
    bounds: [76, 302, 46, 26]
    content:
      fontSize: 17
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "3"
  - elementId: st3t
    elementType: text
    bounds: [128, 302, 318, 42]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Пересчёт раз в две недели.</strong> Доля выбравших Б корректирует закупку"
  - elementId: st4
    elementType: shape
    bounds: [60, 368, 400, 64]
    shapeName: rect
    fill: {type: solid, color: "$goldsoft", radius: 14}
  - elementId: st4n
    elementType: text
    bounds: [76, 380, 46, 26]
    content:
      fontSize: 17
      bold: true
      color: "$risk"
      fontFamily: PT Serif
      text: "4"
  - elementId: st4t
    elementType: text
    bounds: [128, 380, 318, 42]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Индикатор сбоя:</strong> «выбрал Б — не получил Б» стремится к нулю. Если растёт — проблема в объёмах, а не в жителях"
  - elementId: chartbox
    elementType: text
    bounds: [500, 134, 400, 26]
    content:
      fontSize: 12
      color: "$muted"
      fontFamily: Noto Sans
      text: "Пропорции заказов стабилизируются (иллюстративный пример)"
  - elementId: chart
    elementType: chart
    bounds: [500, 168, 400, 270]
    data:
      cols: ["Неделя", "Блюдо А", "Блюдо Б"]
      rows:
        - ["Неделя 1", 60, 40]
        - ["Неделя 2", 55, 45]
        - ["Неделя 4", 52, 48]
    series:
      - type: bar
        name: "Блюдо А"
        fill: "$primary"
      - type: bar
        name: "Блюдо Б"
        fill: "$accent"
    xAxis: {max: 100, title: "% заказов по неделям"}
  - elementId: note
    elementType: text
    bounds: [500, 452, 400, 44]
    content:
      fontSize: 12.5
      color: "$muted"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Заказ невербальных жителей формируется из пищевых карт и вчерашнего показа — та же тетрадь, другой источник."
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, разделы 19.4 и 21 — журнал заказа и три регистра данных"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 364, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "16"
