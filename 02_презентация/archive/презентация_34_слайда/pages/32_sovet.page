pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "СИСТЕМА · ГОЛОС ЖИТЕЛЯ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "От объекта заботы к соавтору меню: совет жителей"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: sub
    elementType: text
    bounds: [60, 124, 840, 30]
    content:
      fontSize: 13
      color: "$muted"
      fontFamily: Noto Sans
      text: "Три модели участия — от информирования к соавторству. Каждая законна; разница — в том, чей голос слышен."
  - elementId: m1
    elementType: shape
    bounds: [60, 172, 266, 180]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: m1h
    elementType: text
    bounds: [76, 186, 234, 30]
    content:
      fontSize: 14
      bold: true
      color: "$muted"
      fontFamily: Noto Sans
      text: "1 · Информирование"
  - elementId: m1t
    elementType: text
    bounds: [76, 222, 234, 118]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Меню вывешено, жители знают, что будет. Голос — в ящике пожеланий. Это не участие, но честный первый шаг."
  - elementId: m2
    elementType: shape
    bounds: [347, 172, 266, 180]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: m2h
    elementType: text
    bounds: [363, 186, 234, 30]
    content:
      fontSize: 14
      bold: true
      color: "$text"
      fontFamily: Noto Sans
      text: "2 · Консультация"
  - elementId: m2t
    elementType: text
    bounds: [363, 222, 234, 118]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Опрос предпочтений (опыт Усть-Илимска), разбор остатков, ежемесячная встреча с кухней. Мнение влияет на цикл меню."
  - elementId: m3
    elementType: shape
    bounds: [634, 172, 266, 180]
    shapeName: rect
    fill: {type: solid, color: "$mintsoft", radius: 14}
  - elementId: m3h
    elementType: text
    bounds: [650, 186, 234, 30]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "3 · Соавторство"
  - elementId: m3t
    elementType: text
    bounds: [650, 222, 234, 118]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "Совет жителей участвует в формировании циклов, пробует новые блюда, видит журнал замен. Формат — особый, с сопровождением."
  - elementId: note
    elementType: shape
    bounds: [60, 372, 840, 104]
    shapeName: rect
    fill: {type: solid, color: "$goldsoft", radius: 14}
  - elementId: notet
    elementType: text
    bounds: [84, 386, 800, 78]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong>Недееспособные жители в совете — не исключение, а особый формат:</strong> сопровождение, доступный язык, право не участвовать. Совет декоративный — хуже, чем никакого: он имитирует голос.</p>
        <p>Конфликт интересов «учреждение = опекун» решается процедурой: решения совета фиксируются, разбираются на квартальной панели, в спорных вопросах — запрос учредителю.</p>
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 34 — права жителей и совет жителей"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 727, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "32"
