pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ТЕХНОЛОГИЯ · БЕЗ ВТОРОЙ КУХНИ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Два варианта — это вторая гастроёмкость и тетрадь, а не вторая кухня"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: sub
    elementType: text
    bounds: [60, 124, 840, 30]
    content:
      fontSize: 13
      color: "$muted"
      fontFamily: Noto Sans
      text: "Вариант Б — из той же заготовки, в том же потоке. Три фильтра: эквивалентность, совместимость с потоком, предсказуемость спроса."
  - elementId: p1
    elementType: shape
    bounds: [60, 172, 404, 72]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: p1t
    elementType: text
    bounds: [78, 186, 372, 46]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Крупы:</strong> гречка / рис / пшено / овсянка — полностью взаимозаменяемы по таблицам"
  - elementId: p2
    elementType: shape
    bounds: [496, 172, 404, 72]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: p2t
    elementType: text
    bounds: [514, 186, 372, 46]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Вторые:</strong> котлета / тефтели · тушёное / печёночный соус · рыба / биточки — одна заготовка, две формы"
  - elementId: p3
    elementType: shape
    bounds: [60, 258, 404, 72]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: p3t
    elementType: text
    bounds: [78, 272, 372, 46]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Салаты:</strong> свекольный / морковный · капустный / винегрет"
  - elementId: p4
    elementType: shape
    bounds: [496, 258, 404, 72]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: p4t
    elementType: text
    bounds: [514, 272, 372, 46]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Напитки:</strong> чай / какао / кофейный напиток — с учётом клозапинового правила (кофеиновая строка карты)"
  - elementId: p5
    elementType: shape
    bounds: [60, 344, 404, 72]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: p5t
    elementType: text
    bounds: [78, 358, 372, 46]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Первые:</strong> борщ / щи · суп крупяной / суп овощной — при готовности к двум котлам"
  - elementId: anti
    elementType: shape
    bounds: [496, 344, 404, 72]
    shapeName: rect
    fill: {type: solid, color: "$risksoft", radius: 14}
  - elementId: antit
    elementType: text
    bounds: [514, 358, 372, 46]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Чего в парах не должно быть:</strong> «гречка или что осталось» — это не выбор, а недо-вариант"
  - elementId: calc
    elementType: text
    bounds: [60, 436, 840, 58]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: |
        <p><strong>Цена модели М1:</strong> сырьё не растёт — перераспределение внутри той же строки. На 30 человек второй вариант каши — это +3–4 кг крупы в сутки при том же суммарном расходе.</p>
        <p>Труд: +5–10 секунд на человека на линии. Разовое: вторая гастроёмкость и маркировка. <em>Расчёт иллюстративный — замер обязателен.</em></p>
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, разделы 19 и 29 — пары эквивалентов и честная цена"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 341, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "15"
