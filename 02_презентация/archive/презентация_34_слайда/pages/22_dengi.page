pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ДЕНЬГИ · ПЯТЬ МОДЕЛЕЙ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Честная цена вариативности: замер, а не обещание"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: sub
    elementType: text
    bounds: [60, 124, 840, 30]
    content:
      fontSize: 13
      color: "$muted"
      fontFamily: Noto Sans
      text: "Мы не утверждаем, что вариативность «почти бесплатна». Мы утверждаем: цена определяется замером — до старта и через 90 дней."
  - elementId: table
    elementType: table
    bounds: [60, 168, 840, 260]
    columnWidths: [0.18, 0.32, 0.26, 0.24]
    rows:
      - ["Модель", "Что меняется", "Сырьё / труд", "Разовые затраты"]
      - ["М1. Выбор из двух (завтрак+обед, 2–3 дня в неделю)", "Вторая гастроёмкость, журнал заказа", "≈0 — перераспределение пар · +минуты на линии", "Гастроёмкости, маркеры"]
      - ["М2. Выбор ежедневно по позициям", "Тот же принцип в полном объёме", "≈0 при пересчёте по статистике · +время учёта", "Визуальное меню"]
      - ["М3. Буфетная зона (салаты, напитки)", "Самообслуживание в зоне", "Рост потребления → пересчёт · контроль зоны", "Стеллажи, посуда"]
      - ["М4. Семейная подача (точечно)", "Подача общими блюдами", "≈0 · меняется роль персонала", "Столовая посуда"]
      - ["М5. «Своя кухня» (реабилитация)", "Программа навыков", "Как у группы · персонал-сопровождающий", "Кухонная зона"]
    style:
      firstRowStyle: {color: "$primary", fontSize: 12.5}
      cellStyle: {color: "$text", fontSize: 11.5}
  - elementId: key
    elementType: shape
    bounds: [60, 448, 840, 48]
    shapeName: rect
    fill: {type: solid, color: "$mintsoft", radius: 14}
  - elementId: keyt
    elementType: text
    bounds: [84, 456, 800, 32]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Ключевой механизм М1–М2:</strong> сырьё не добавляется — перераспределяется внутри той же строки через пары эквивалентов. Модельные оценки, не замеры: ваша цифра — после семи дней замера."
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 29 — финансовые модели; форма замера — приложение 25"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 500, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "22"
