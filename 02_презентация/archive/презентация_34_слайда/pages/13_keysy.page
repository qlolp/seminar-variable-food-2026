pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$mint"}
  - elementId: motif
    elementType: shape
    bounds: [790, -120, 300, 300]
    shapeName: ellipse
    opacity: 0.20
    fill: {type: solid, color: "$accent"}
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ПРАКТИКА · РОССИЙСКИЕ КЕЙСЫ"
  - elementId: title
    elementType: text
    bounds: [60, 48, 840, 70]
    content:
      fontSize: 26
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Четыре публичных кейса. Один из них назвал и цену"
  - elementId: line
    elementType: shape
    bounds: [60, 124, 72, 4]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: k1
    elementType: shape
    bounds: [60, 134, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: k1t
    elementType: text
    bounds: [78, 148, 372, 130]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong style="font-size:14.5px">Болотнинский ПНИ</strong> · Новосибирская область, с 2024</p>
        <p>Выбор из двух на завтраке и обеде, несколько раз в неделю. Перечень пар определяет диетсестра. Модель М1.</p>
  - elementId: k2
    elementType: shape
    bounds: [496, 134, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: k2t
    elementType: text
    bounds: [514, 148, 372, 130]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong style="font-size:14.5px">Успенский ПНИ</strong> · Новосибирская область, с 2024</p>
        <p>Два вторых, два салата, два напитка — ежедневно, все отделения. «Страхи не подтвердились». Модель М2.</p>
  - elementId: k3
    elementType: shape
    bounds: [60, 306, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: k3t
    elementType: text
    bounds: [78, 320, 372, 130]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong style="font-size:14.5px">Усть-Илимский дом социального обслуживания</strong> · Иркутская область, с сентября 2024</p>
        <p>Начали с опроса предпочтений жителей. Модели М1–М2.</p>
  - elementId: k4
    elementType: shape
    bounds: [496, 306, 404, 158]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 14}
  - elementId: k4t
    elementType: text
    bounds: [514, 320, 372, 130]
    content:
      fontSize: 13
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p><strong style="font-size:14.5px">ДСО «Серафимовский»</strong> · Санкт-Петербург, 2025</p>
        <p>Дом докладчика. Старт не был «без новых денег»: оборудование и ставки названы прямо. Новость учредителя — факт сообщения, не аудит.</p>
  - elementId: region
    elementType: shape
    bounds: [60, 478, 840, 34]
    shapeName: rect
    fill: {type: solid, color: "$mintsoft", radius: 14}
  - elementId: regiont
    elementType: text
    bounds: [84, 484, 800, 24]
    content:
      fontSize: 12.5
      color: "$text"
      fontFamily: Noto Sans
      text: "<strong>Иркутская область</strong> — единственный заявленный случай масштаба области (S018, источник вторичный)"
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, раздел 25 — четыре подтверждённых кейса; источники S015–S018, S030"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 295, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "13"
