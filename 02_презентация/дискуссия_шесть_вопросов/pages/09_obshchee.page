pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ПЕРЕКЛИЧКА · ДВА ДОМА"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Серафимовский и Тесовый берег: что общего и что разное"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: same_h
    elementType: text
    bounds: [60, 130, 404, 26]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Общее — то, что нельзя обойти:"
  - elementId: s1
    elementType: shape
    bounds: [60, 164, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: s1t
    elementType: text
    bounds: [76, 172, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Один учредитель, один СанПиН (с 01.09.2026 — 4282-26), одни нормы Минтруда; оба дома — автономные, закупки по 223-ФЗ"
  - elementId: s2
    elementType: shape
    bounds: [60, 228, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: s2t
    elementType: text
    bounds: [76, 236, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Один контингент: люди с психическими нарушениями, часть — недееспособны"
  - elementId: s3
    elementType: shape
    bounds: [60, 292, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: s3t
    elementType: text
    bounds: [76, 300, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Один вызов: качество при нормированной цене и жёсткой проверке"
  - elementId: s4
    elementType: shape
    bounds: [60, 356, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: s4t
    elementType: text
    bounds: [76, 364, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Одна цель: еда как ежедневный тест на уважение"
  - elementId: diff_h
    elementType: text
    bounds: [496, 130, 404, 26]
    content:
      fontSize: 14
      bold: true
      color: "$primary"
      fontFamily: Noto Sans
      text: "Разное — то, что даёт материал:"
  - elementId: d1
    elementType: shape
    bounds: [496, 164, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$goldsoft", radius: 8}
  - elementId: d1t
    elementType: text
    bounds: [512, 172, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Модели совмещения: Серафимовский — диетстолы внутри основного питания; Тесовый берег — совмещённые пары на одной линии"
  - elementId: d2
    elementType: shape
    bounds: [496, 228, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$goldsoft", radius: 8}
  - elementId: d2t
    elementType: text
    bounds: [512, 236, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Масштаб, профиль отделений, возраст контингента — разные пропорции"
  - elementId: d3
    elementType: shape
    bounds: [496, 292, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$goldsoft", radius: 8}
  - elementId: d3t
    elementType: text
    bounds: [512, 300, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Хронология проектов: кто-то стартовал раньше — у кого-то свежий старт"
  - elementId: d4
    elementType: shape
    bounds: [496, 356, 404, 54]
    shapeName: rect
    fill: {type: solid, color: "$goldsoft", radius: 8}
  - elementId: d4t
    elementType: text
    bounds: [512, 364, 372, 40]
    content:
      fontSize: 12.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Опыт сбоев: у кого-то есть «где ломалось» — самый ценный материал"
  - elementId: ask
    elementType: text
    bounds: [60, 436, 840, 58]
    content:
      fontSize: 14.5
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: "<strong>Вопрос залу:</strong> в каком месте этого списка ваш дом? Поднимите руку — своя кухня или аутсорсинг; стартовали или только планируете; есть ли уже «где ломалось»?"
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Раздел 17.12 доклада · разделы 25 (кейсы) и 42 (аутсорсинг)"
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "9"
