version: v2
title: Не просто накормить — презентация семинара
size: [960, 540]
theme:
  colors:
    primary: "#B85C3D"
    accent: "#D97757"
    text: "#141413"
    muted: "#8A8578"
    bg: "#F9F9F7"
    soft: "#F2EFE6"
    softgreen: "#F2EFE6"
    line: "#E5E2D8"
  textStyles:
    kicker:
      fontSize: 11
      color: "$primary"
      fontFamily: Noto Sans
      letterSpacing: 2
      bold: true
    h1:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
    body:
      fontSize: 14.5
      color: "$text"
      fontFamily: Noto Sans
      lineHeight: 1.45
    small:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      lineHeight: 1.3
    big:
      fontSize: 46
      bold: true
      color: "$primary"
      fontFamily: PT Serif
    q:
      fontSize: 30
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      lineHeight: 1.25
