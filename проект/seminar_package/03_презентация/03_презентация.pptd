version: v2
title: Не просто накормить — презентация семинара
size: [960, 540]
theme:
  colors:
    primary: "#1B365D"
    accent: "#C41E3A"
    text: "#1A1915"
    muted: "#5C5A56"
    bg: "#F7F4EE"
    soft: "#E8E4DA"
    line: "#D0CBBF"
    risk: "#C41E3A"
    dark: "#1B2A4E"
    darkcard: "#243556"
    cream: "#F7F4EE"
    sand: "#D4CFC4"
    mint: "#2C4A6E"
    ink: "#0F1C33"
    darkmuted: "#8A93A3"
    mintsoft: "#E4EAF2"
    goldsoft: "#F6E4E6"
    risksoft: "#F6E4E6"
    goldink: "#8B1E2D"
  textStyles:
    kicker:
      fontSize: 11
      color: "$primary"
      fontFamily: Noto Sans
      letterSpacing: 2
      bold: true
    h1:
      fontSize: 32
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
    body:
      fontSize: 14.5
      color: "$text"
      fontFamily: Noto Sans
      lineHeight: 1.45
    small:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      lineHeight: 1.3
    big:
      fontSize: 46
      bold: true
      color: "$primary"
      fontFamily: PT Serif
    q:
      fontSize: 30
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      lineHeight: 1.25
