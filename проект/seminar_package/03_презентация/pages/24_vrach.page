pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ГРАНИЦА · РАЗДЕЛЫ 9–11"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Врач назначает. Директор организует."
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: left
    elementType: shape
    bounds: [60, 128, 410, 260]
    shapeName: rect
    cornerRadius: 16
    fill: {type: solid, color: "$soft"}
  - elementId: lh
    elementType: text
    bounds: [84, 148, 360, 32]
    content:
      fontSize: 18
      bold: true
      fontFamily: PT Serif
      text: "Врач"
  - elementId: lt
    elementType: text
    bounds: [84, 188, 360, 176]
    content:
      fontSize: 16
      lineHeight: 1.5
      text: "<p>· текстуры и загущённые жидкости</p><p>· три отказа → осмотр сегодня</p><p>· таблица «лекарство × еда»</p>"
  - elementId: right
    elementType: shape
    bounds: [490, 128, 410, 260]
    shapeName: rect
    cornerRadius: 16
    fill: {type: solid, color: "$soft"}
  - elementId: rh
    elementType: text
    bounds: [514, 148, 360, 32]
    content:
      fontSize: 18
      bold: true
      fontFamily: PT Serif
      color: "$primary"
      text: "Директор"
  - elementId: rt
    elementType: text
    bounds: [514, 188, 360, 176]
    content:
      fontSize: 16
      lineHeight: 1.5
      color: "$primary"
      text: "<p>· журналы и приказ о мониторинге</p><p>· один список «кому трудно есть»</p><p>· обучение смен признакам</p>"
  - elementId: bottom
    elementType: text
    bounds: [60, 412, 840, 52]
    content:
      fontSize: 16
      bold: true
      lineHeight: 1.35
      text: "Здоровье конкретного жителя — по назначению врача, в документе. Иначе вариативность компрометируют."
  - elementId: src
    elementType: text
    bounds: [60, 500, 780, 28]
    content:
      style: "$small"
      text: "Полный лист границ — семинарский пакет, элемент 18."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "35"
