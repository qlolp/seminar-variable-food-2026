pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 700, 16]
    content:
      style: "$kicker"
      text: 'ЖУРНАЛ ЗАКАЗА · КАК ЧИТАТЬ ЦИФРЫ'
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Две недели заказов — и пропорции готовки меняются"
  - elementId: line
    elementType: shape
    bounds: [60, 108, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: chart
    elementType: chart
    bounds: [60, 126, 840, 330]
    fontFamily: "Noto Sans"
    data:
      cols: ["Неделя", "A", "B", "C"]
      rows:
      - ["Неделя 1", 60, 30, 10]
      - ["Неделя 2", 45, 40, 15]
    series:
      - type: bar
        encode: {x: "Неделя", y: "A"}
        name: "Блюдо А (основное)"
        stack: "percent"
        fill: "#B85C3D"
        dataLabels: {show: true, color: "#FFFFFF"}
      - type: bar
        encode: {x: "Неделя", y: "B"}
        name: "Блюдо Б"
        stack: "percent"
        fill: "$accent"
        dataLabels: {show: true, color: "#FFFFFF"}
      - type: bar
        encode: {x: "Неделя", y: "C"}
        name: "Блюдо В (диетическое)"
        stack: "percent"
        fill: "#A8A294"
        dataLabels: {show: true, color: "#FFFFFF"}
    legend: {position: bottom, color: "#6E6A5E"}
    yAxis: {min: 0, max: 100, title: "% заказов", label: {color: "#8A8578"}, gridLine: {color: "#E5E2D8"}}
    xAxis: {label: {color: "#4A463C"}, axisLine: {color: "#D6D1C4"}, gridLine: false}
    barWidth: 0.4

  - elementId: note
    elementType: text
    bounds: [60, 462, 840, 40]
    content:
      fontSize: 12.5
      lineHeight: 1.45
      color: "$text"
      fontFamily: "Noto Sans"
      text: "Иллюстративный пример заполнения формы: заказ накануне показывает реальный спрос, и пропорции готовки корректируются по журналу, а не по привычке."

  - elementId: src
    elementType: text
    bounds: [60, 508, 760, 24]
    content:
      style: "$small"
      text: "Раздел 21 доклада; форма журнала заказа — приложение"
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "#A8A294"
      align: [right, top]
      text: "23"
