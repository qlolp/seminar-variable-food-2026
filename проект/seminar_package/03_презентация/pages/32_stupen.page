pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 700, 16]
    content:
      style: "$kicker"
      text: "ИНТЕРАКТИВ · 3 МИНУТЫ · РАЗДЕЛЫ 8.6–8.7"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Три вопроса к вчерашнему дню — не к положению"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: c1
    elementType: shape
    bounds: [60, 128, 840, 96]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: n1
    elementType: shape
    bounds: [80, 148, 36, 36]
    shapeName: oval
    fill: {type: solid, color: "$primary"}
  - elementId: n1t
    elementType: text
    bounds: [80, 148, 36, 36]
    content:
      fontSize: 16
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: "1"
  - elementId: t1
    elementType: text
    bounds: [132, 144, 740, 64]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>Покажите вчерашний журнал заказа.</strong></p><p>Нет записи — ступень участия не выше первой, что бы ни говорило положение.</p>"
  - elementId: c2
    elementType: shape
    bounds: [60, 240, 840, 96]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: n2
    elementType: shape
    bounds: [80, 260, 36, 36]
    shapeName: oval
    fill: {type: solid, color: "$primary"}
  - elementId: n2t
    elementType: text
    bounds: [80, 260, 36, 36]
    content:
      fontSize: 16
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: "2"
  - elementId: t2
    elementType: text
    bounds: [132, 256, 740, 64]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>Второй вариант вчера физически стоял на линии?</strong></p><p>«Закончился к первому отделению» = доступности нет.</p>"
  - elementId: c3
    elementType: shape
    bounds: [60, 352, 840, 96]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: n3
    elementType: shape
    bounds: [80, 372, 36, 36]
    shapeName: oval
    fill: {type: solid, color: "$primary"}
  - elementId: n3t
    elementType: text
    bounds: [80, 372, 36, 36]
    content:
      fontSize: 16
      bold: true
      color: "#FFFFFF"
      align: [center, middle]
      text: "3"
  - elementId: t3
    elementType: text
    bounds: [132, 368, 740, 64]
    content:
      fontSize: 16
      lineHeight: 1.35
      text: "<p><strong>Назовите жителя, который вчера выбрал не дефолт.</strong></p><p>Если таких нет третью неделю — выбор декоративен.</p>"
  - elementId: src
    elementType: text
    bounds: [60, 500, 780, 28]
    content:
      style: "$small"
      text: "Форма самоопределения — семинарский пакет, элемент 12."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "12"
