pageType: cover
background:
  type: solid
  color: "$dark"
elements:
  - elementId: rail
    elementType: shape
    bounds: [0, 0, 8, 540]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: panel
    elementType: shape
    bounds: [620, 0, 340, 540]
    shapeName: rect
    fill: {type: solid, color: "$ink"}
  - elementId: motif
    elementType: shape
    bounds: [700, -90, 320, 320]
    shapeName: ellipse
    opacity: 0.22
    fill: {type: solid, color: "$mint"}
  - elementId: motif2
    elementType: shape
    bounds: [780, 360, 240, 240]
    shapeName: ellipse
    opacity: 0.14
    fill: {type: solid, color: "$accent"}
  - elementId: goldbar
    elementType: shape
    bounds: [48, 56, 88, 6]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: brand
    elementType: text
    bounds: [48, 76, 540, 22]
    content:
      fontSize: 13
      color: "$accent"
      letterSpacing: 3
      bold: true
      fontFamily: Noto Sans
      text: "ПРОСТРАНСТВО НОВЫХ ИДЕЙ 2.0"
  - elementId: kicker
    elementType: text
    bounds: [48, 128, 540, 18]
    content:
      fontSize: 11
      color: "$darkmuted"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "МЕЖРЕГИОНАЛЬНЫЙ СЕМИНАР · МИНТРУД РОССИИ"
  - elementId: title
    elementType: text
    bounds: [48, 158, 540, 130]
    content:
      fontSize: 52
      bold: true
      color: "$cream"
      lineHeight: 1.02
      fontFamily: PT Serif
      text: "Не просто накормить"
  - elementId: subtitle
    elementType: text
    bounds: [48, 300, 540, 88]
    content:
      fontSize: 16
      color: "$sand"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Как организовать безопасное, достойное и вариативное питание людей с психическими нарушениями в домах социального обслуживания"
  - elementId: meta
    elementType: text
    bounds: [48, 410, 540, 72]
    content:
      fontSize: 13
      color: "$cream"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: |
        <p>Санкт-Петербург, 25–27 августа 2026</p>
        <p>Чистяков Е. В. · ДСО «Серафимовский»</p>
        <p>26.08, 14.00–15.30: «Организация питания: опыт реализации проектов»</p>
  - elementId: s1n
    elementType: text
    bounds: [656, 70, 270, 54]
    content:
      fontSize: 40
      bold: true
      color: "$accent"
      fontFamily: PT Serif
      text: "323"
  - elementId: s1l
    elementType: text
    bounds: [656, 122, 270, 22]
    content:
      fontSize: 13
      color: "$sand"
      fontFamily: Noto Sans
      text: "страницы доклада"
  - elementId: s2n
    elementType: text
    bounds: [656, 170, 270, 54]
    content:
      fontSize: 40
      bold: true
