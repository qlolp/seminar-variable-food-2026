pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ВОЛЯ · ДЕЕСПОСОБНОСТЬ"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "74 % недееспособны — но выбор блюда не сделка"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: big
    elementType: text
    bounds: [60, 136, 320, 130]
    content:
      fontSize: 72
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "74 %"
  - elementId: bigl
    elementType: text
    bounds: [60, 262, 320, 64]
    content:
      fontSize: 13.5
      color: "$text"
      lineHeight: 1.45
      fontFamily: Noto Sans
      text: "жителей ПНИ признаны недееспособными. Признание означает опеку над сделками — но <strong>не отменяет бытовых предпочтений</strong>."
  - elementId: law
    elementType: text
    bounds: [60, 344, 320, 120]
    content:
      fontSize: 12.5
      color: "$muted"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: |
        <p>Ст. 29 ГК РФ — сделки совершает опекун. Выбор каши — не сделка.</p>
        <p>Закон требует учитывать мнение недееспособного в вопросах, затрагивающих его интересы. Замечание общего порядка № 1 к ст. 12 КПИ — поддержанное решение, а не подмена.</p>
  - elementId: ch1
    elementType: shape
    bounds: [420, 136, 480, 76]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: ch1t
    elementType: text
    bounds: [440, 152, 444, 46]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Слово</strong> — по меню, по картинке, доступным языком"
  - elementId: ch2
    elementType: shape
    bounds: [420, 224, 480, 76]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: ch2t
    elementType: text
    bounds: [440, 240, 444, 46]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Показ</strong> — две порции перед глазами: выбор указанием, жестом, взглядом"
  - elementId: ch3
    elementType: shape
    bounds: [420, 312, 480, 76]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: ch3t
    elementType: text
    bounds: [440, 328, 444, 46]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Наблюдение</strong> — что доедается, а что отодвигается: устойчивый паттерн потребления"
  - elementId: ch4
    elementType: shape
    bounds: [420, 400, 480, 76]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: ch4t
    elementType: text
    bounds: [440, 416, 444, 46]
    content:
      fontSize: 14
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "<strong>Биография</strong> — пищевая история человека, когда спросить уже некого"
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, разделы 15 и 16 — четыре канала воли и карта решений"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 250, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "11"
