pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ГЛАВНАЯ СХЕМА ДОКЛАДА"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Лестница вариативности: не пропасть, а шесть ступеней"
  - elementId: line
    elementType: shape
    bounds: [60, 108, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: s0
    elementType: shape
    bounds: [60, 390, 130, 70]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: s0t
    elementType: text
    bounds: [66, 394, 118, 62]
    content:
      fontSize: 11
      color: "#FFFFFF"
      lineHeight: 1.25
      text: |
        <p><strong>0. Мономеню</strong></p>
        <p>с учётом отказов</p>
  - elementId: s1
    elementType: shape
    bounds: [200, 355, 130, 105]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: s1t
    elementType: text
    bounds: [206, 359, 118, 97]
    content:
      fontSize: 11
      color: "#FFFFFF"
      lineHeight: 1.25
      text: |
        <p><strong>1. Два варианта</strong></p>
        <p>одной позиции, часть дней</p>
  - elementId: s2
    elementType: shape
    bounds: [340, 320, 130, 140]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: s2t
    elementType: text
    bounds: [346, 324, 118, 132]
    content:
      fontSize: 11
      color: "#FFFFFF"
      lineHeight: 1.25
      text: |
        <p><strong>2. Два варианта</strong></p>
        <p>всех основных позиций, ежедневно</p>
  - elementId: s3
    elementType: shape
    bounds: [480, 285, 130, 175]
    shapeName: rect
    fill: {type: solid, color: "$bg"}
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: s3t
    elementType: text
    bounds: [486, 289, 118, 167]
    content:
      fontSize: 11
      color: "$primary"
      lineHeight: 1.25
      text: |
        <p><strong>3. Выбор</strong></p>
        <p>на линии раздачи (буфетная зона)</p>
  - elementId: s4
    elementType: shape
    bounds: [620, 250, 130, 210]
    shapeName: rect
    fill: {type: solid, color: "$bg"}
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: s4t
    elementType: text
    bounds: [626, 254, 118, 202]
    content:
      fontSize: 11
      color: "$primary"
      lineHeight: 1.25
      text: |
        <p><strong>4. Семейная подача</strong></p>
        <p>за столом, точечно</p>
  - elementId: s5
    elementType: shape
    bounds: [760, 215, 130, 245]
    shapeName: rect
    fill: {type: solid, color: "$bg"}
    border: {style: dash, width: 2, color: "$muted"}
  - elementId: s5t
    elementType: text
    bounds: [766, 219, 118, 237]
    content:
      fontSize: 11
      color: "$muted"
      lineHeight: 1.25
      text: |
        <p><strong>5. «Своя кухня»</strong></p>
        <p>жители готовят сами — горизонт</p>
  - elementId: mark
    elementType: text
    bounds: [60, 148, 620, 60]
    content:
      fontSize: 13.5
      bold: true
      color: "$primary"
      lineHeight: 1.4
      text: |
        <p>Ступени 1–2 подтверждены действующими российскими практиками —</p>
        <p>это реалистичный горизонт большинства участников семинара на ближайший год</p>
  - elementId: src
    elementType: text
    bounds: [60, 480, 780, 44]
    content:
      style: "$small"
      text: "Источник: раздел 8.2 доклада; подтверждённые практики ступеней 1–2 — Болотнинский и Успенский ПНИ, Иркутская область (сайты учреждений, 2026); ступень 4 — Nijs et al., 2006; ступени 3 и 5 — применимы выборочно/на горизонте"
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "9"
