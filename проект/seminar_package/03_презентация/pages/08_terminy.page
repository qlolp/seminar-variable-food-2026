pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 34, 600, 16]
    content:
      style: "$kicker"
      text: "ТЕРМИНЫ · РАЗДЕЛ 8.1"
  - elementId: title
    elementType: text
    bounds: [60, 56, 840, 40]
    content:
      style: "$h1"
      text: "Четыре слова. Выбор — только одно из них"
  - elementId: line
    elementType: shape
    bounds: [60, 104, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: c1
    elementType: shape
    bounds: [60, 128, 410, 130]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t1
    elementType: text
    bounds: [80, 144, 370, 98]
    content:
      fontSize: 15
      lineHeight: 1.35
      text: "<p><strong>Цикл 14 дней</strong></p><p>Разнообразие во времени. Не выбор.</p>"
  - elementId: c2
    elementType: shape
    bounds: [490, 128, 410, 130]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t2
    elementType: text
    bounds: [510, 144, 370, 98]
    content:
      fontSize: 15
      lineHeight: 1.35
      text: "<p><strong>Замена по таблице</strong></p><p>Делает вариативность законной. Сама выбором не является.</p>"
  - elementId: c3
    elementType: shape
    bounds: [60, 274, 410, 130]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$soft"}
  - elementId: t3
    elementType: text
    bounds: [80, 290, 370, 98]
    content:
      fontSize: 15
      lineHeight: 1.35
      text: "<p><strong>Персонализация</strong></p><p>Текстуры и назначения. Решает врач.</p>"
  - elementId: c4
    elementType: shape
    bounds: [490, 274, 410, 130]
    shapeName: rect
    cornerRadius: 14
    fill: {type: solid, color: "$primary"}
  - elementId: t4
    elementType: text
    bounds: [510, 290, 370, 98]
    content:
      fontSize: 15
      lineHeight: 1.35
      color: "#FFFFFF"
      text: "<p><strong>Вариативное меню</strong></p><p>Не меньше двух реальных вариантов. Житель влияет, какой получит.</p>"
  - elementId: src
    elementType: text
    bounds: [60, 430, 840, 64]
    content:
      style: "$small"
      text: "Раздел 8.1. «14 дней без повторов» и «гречку меняем на рис» — ещё не выбор жителя."
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      style: "$small"
      align: [right, top]
      text: "9"
