pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [60, 30, 700, 16]
    content:
      fontSize: 11
      color: "$primary"
      letterSpacing: 2
      bold: true
      fontFamily: Noto Sans
      text: "ЗАМЕР №1 · НОЧНОЙ ИНТЕРВАЛ"
  - elementId: title
    elementType: text
    bounds: [60, 54, 840, 42]
    content:
      fontSize: 27
      bold: true
      color: "$text"
      fontFamily: PT Serif
      lineHeight: 1.15
      text: "Сколько часов житель не ест: от ужина до завтрака"
  - elementId: line
    elementType: shape
    bounds: [60, 106, 840, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}
  - elementId: lab1
    elementType: text
    bounds: [60, 150, 230, 30]
    content:
      fontSize: 14.5
      color: "$text"
      fontFamily: Noto Sans
      text: "Швеция — норма"
  - elementId: bar1bg
    elementType: shape
    bounds: [300, 156, 440, 18]
    shapeName: rect
    fill: {type: solid, color: "#EFE9DD"}
  - elementId: bar1
    elementType: shape
    bounds: [300, 156, 302, 18]
    shapeName: rect
    fill: {type: solid, color: "$primary", radius: 3}
  - elementId: val1
    elementType: text
    bounds: [750, 148, 120, 30]
    content:
      fontSize: 16
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "11 часов"
  - elementId: lab2
    elementType: text
    bounds: [60, 200, 230, 30]
    content:
      fontSize: 14.5
      color: "$text"
      fontFamily: Noto Sans
      text: "США — норма CMS"
  - elementId: bar2bg
    elementType: shape
    bounds: [300, 206, 440, 18]
    shapeName: rect
    fill: {type: solid, color: "#EFE9DD"}
  - elementId: bar2
    elementType: shape
    bounds: [300, 206, 385, 18]
    shapeName: rect
    fill: {type: solid, color: "$primary", radius: 3}
  - elementId: val2
    elementType: text
    bounds: [750, 198, 120, 30]
    content:
      fontSize: 16
      bold: true
      color: "$primary"
      fontFamily: PT Serif
      text: "14 часов"
  - elementId: lab3
    elementType: text
    bounds: [60, 250, 230, 30]
    content:
      fontSize: 14.5
      color: "$text"
      fontFamily: Noto Sans
      text: "Типовой распорядок, РФ"
  - elementId: bar3bg
    elementType: shape
    bounds: [300, 256, 440, 18]
    shapeName: rect
    fill: {type: solid, color: "#EFE9DD"}
  - elementId: bar3
    elementType: shape
    bounds: [300, 256, 413, 18]
    shapeName: rect
    fill: {type: solid, color: "$risk", radius: 3}
  - elementId: val3
    elementType: text
    bounds: [750, 248, 150, 30]
    content:
      fontSize: 16
      bold: true
      color: "$risk"
      fontFamily: PT Serif
      text: "≈15 часов"
  - elementId: cal
    elementType: shape
    bounds: [60, 306, 840, 74]
    shapeName: rect
    fill: {type: solid, color: "$soft", radius: 8}
  - elementId: calt
    elementType: text
    bounds: [84, 318, 800, 52]
    content:
      fontSize: 14.5
      color: "$text"
      lineHeight: 1.4
      fontFamily: Noto Sans
      text: "Ужин в 17:30, завтрак в 8:30 — пятнадцать часов без еды. <strong>Это не экзотика, а типовой график.</strong> Для жителей на антипсихотиках голодная ночь — путь к ночным набегам на кухню и к чужим тарелкам."
  - elementId: ask
    elementType: text
    bounds: [60, 404, 840, 66]
    content:
      fontSize: 15
      color: "$text"
      lineHeight: 1.5
      fontFamily: Noto Sans
      text: |
        <p><strong>Вопрос залу:</strong> какая цифра в вашем доме — от последней подачи ужина до первого завтрака?</p>
        <p>Замер занимает три дня и не требует ни рубля. Обычно реальный интервал отличается от графика на бумаге.</p>
  - elementId: fix
    elementType: text
    bounds: [60, 478, 840, 30]
    content:
      fontSize: 13
      color: "$muted"
      fontFamily: Noto Sans
      text: "Бесплатные меры: поздний перекус по списку с врачом · сдвиг ужина внутри существующего распорядка · контроль фактического времени подачи"
  - elementId: src
    elementType: text
    bounds: [60, 508, 700, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      fontFamily: Noto Sans
      text: "Доклад, разделы 6 и 13.4 · нормы: шведские и американские протоколы (реестр практик); значение РФ — оценка по типовым графикам"
  - elementId: progress
    elementType: shape
    bounds: [60, 530, 159, 4]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: pg
    elementType: text
    bounds: [900, 508, 40, 20]
    content:
      fontSize: 10.5
      color: "$muted"
      align: [right, top]
      text: "7"
